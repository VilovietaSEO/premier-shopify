{% if section.settings.enabled %}
  <section class="ip-announcement full-width" aria-label="Store announcement">
    <div class="ip-announcement__inner">
      {% if section.settings.text != blank %}
        {% if section.settings.link != blank %}
          <a href="{{ section.settings.link }}">
            <span class="ip-announcement__full">{{ section.settings.text | newline_to_br }}</span>
            <span class="ip-announcement__compact">{{ section.settings.compact_text | strip | newline_to_br }}</span>
          </a>
        {% else %}
          <p>
            <span class="ip-announcement__full">{{ section.settings.text | newline_to_br }}</span>
            <span class="ip-announcement__compact">{{ section.settings.compact_text | strip | newline_to_br }}</span>
          </p>
        {% endif %}
      {% endif %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "IP announcement banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show announcement banner",
      "default": false
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Banner text"
    },
    {
      "type": "textarea",
      "id": "compact_text",
      "label": "Compact banner text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    }
  ],
  "presets": [
    {
      "name": "IP announcement banner"
    }
  ]
}
{% endschema %}
