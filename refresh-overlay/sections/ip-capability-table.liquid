<section class="ip-section">
  <div class="ip-stack">
    {% if section.settings.eyebrow != blank %}
      <p class="ip-kicker">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="ip-heading ip-heading--medium ip-heading--wide">{{ section.settings.heading }}</h2>
    <div class="ip-lede">{{ section.settings.body }}</div>
  </div>

  <div class="ip-capability" style="margin-top: 2rem;" role="table" aria-label="{{ section.settings.heading | escape }}">
    <div class="ip-capability__row" role="row">
      <div class="ip-capability__cell ip-capability__head" role="columnheader">Capability</div>
      <div class="ip-capability__cell ip-capability__head" role="columnheader">Status</div>
      <div class="ip-capability__cell ip-capability__head" role="columnheader">How to explain it</div>
    </div>
    {% for block in section.blocks %}
      <div class="ip-capability__row" role="row" {{ block.shopify_attributes }}>
        <div class="ip-capability__cell" role="cell"><strong>{{ block.settings.capability }}</strong></div>
        <div class="ip-capability__cell" role="cell">
          <span class="ip-status ip-status--{{ block.settings.status_style }}">{{ block.settings.status }}</span>
        </div>
        <div class="ip-capability__cell" role="cell">{{ block.settings.explanation }}</div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "IP capability table",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Plain answers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What it does, and what it is not trying to be."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>The page should answer parent questions directly. If a feature is not in the supplied launch specs, do not market it as included.</p>"
    }
  ],
  "blocks": [
    {
      "type": "capability",
      "name": "Capability row",
      "settings": [
        {
          "type": "text",
          "id": "capability",
          "label": "Capability",
          "default": "Calls"
        },
        {
          "type": "text",
          "id": "status",
          "label": "Status",
          "default": "Yes"
        },
        {
          "type": "select",
          "id": "status_style",
          "label": "Status style",
          "options": [
            { "value": "yes", "label": "Yes" },
            { "value": "no", "label": "No" },
            { "value": "plain", "label": "Plain" }
          ],
          "default": "yes"
        },
        {
          "type": "textarea",
          "id": "explanation",
          "label": "Explanation",
          "default": "The product is built around calling and a personal phone number."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IP capability table",
      "blocks": [
        {
          "type": "capability",
          "settings": {
            "capability": "Calls",
            "status": "Yes",
            "status_style": "yes",
            "explanation": "The product is built around calling and a personal phone number."
          }
        },
        {
          "type": "capability",
          "settings": {
            "capability": "Wi-Fi handset",
            "status": "Yes",
            "status_style": "yes",
            "explanation": "Both products are cordless Wi-Fi handsets with charging bases."
          }
        },
        {
          "type": "capability",
          "settings": {
            "capability": "Web browser",
            "status": "No",
            "status_style": "no",
            "explanation": "The product is positioned as a phone without web browsing."
          }
        },
        {
          "type": "capability",
          "settings": {
            "capability": "App store / social media / YouTube",
            "status": "No",
            "status_style": "no",
            "explanation": "The product promise is calling without apps, feeds, or the open internet."
          }
        },
        {
          "type": "capability",
          "settings": {
            "capability": "SMS, GPS, camera, cellular mobility",
            "status": "Not in supplied specs",
            "status_style": "plain",
            "explanation": "Do not market these as included unless the product/service scope changes."
          }
        },
        {
          "type": "capability",
          "settings": {
            "capability": "Spam screening",
            "status": "Add-on",
            "status_style": "plain",
            "explanation": "Auto Attendant is available for $5/mo and is presented as an add-on."
          }
        }
      ]
    }
  ]
}
{% endschema %}
