{% render 'ip-order-builder-form',
  builder_id: section.id,
  standard_product: section.settings.standard_product,
  rugged_product: section.settings.rugged_product,
  monthly_service_product: section.settings.monthly_service_product,
  annual_service_product: section.settings.annual_service_product,
  call_recording_product: section.settings.call_recording_product,
  family_quiet_hours_product: section.settings.family_quiet_hours_product,
  voicemail_to_email_product: section.settings.voicemail_to_email_product,
  auto_attendant_product: section.settings.auto_attendant_product,
  addon_bundle_product: section.settings.addon_bundle_product,
  heading: section.settings.heading,
  body: section.settings.body,
  checkout_note: section.settings.checkout_note,
  button_label: section.settings.button_label
%}

{% schema %}
{
  "name": "IP order builder",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your Independence Phone order now."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Choose your phone, service plan, and add-ons below.</p>"
    },
    {
      "type": "product",
      "id": "standard_product",
      "label": "Classic Phone product"
    },
    {
      "type": "product",
      "id": "rugged_product",
      "label": "Rugged Phone product"
    },
    {
      "type": "product",
      "id": "monthly_service_product",
      "label": "Monthly service billing product"
    },
    {
      "type": "product",
      "id": "annual_service_product",
      "label": "Annual service billing product"
    },
    {
      "type": "product",
      "id": "call_recording_product",
      "label": "Call Recording billing product"
    },
    {
      "type": "product",
      "id": "family_quiet_hours_product",
      "label": "Quiet Hours billing product"
    },
    {
      "type": "product",
      "id": "voicemail_to_email_product",
      "label": "Voicemail to Email billing product"
    },
    {
      "type": "product",
      "id": "auto_attendant_product",
      "label": "Auto Attendant billing product"
    },
    {
      "type": "product",
      "id": "addon_bundle_product",
      "label": "Add-on Bundle billing product"
    },
    {
      "type": "textarea",
      "id": "checkout_note",
      "label": "Checkout note",
      "default": "Taxes, shipping, and recurring billing will be shown in the cart."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add order to cart"
    }
  ],
  "presets": [
    {
      "name": "IP order builder"
    }
  ]
}
{% endschema %}
