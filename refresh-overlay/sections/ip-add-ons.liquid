<section class="ip-section">
  <div class="ip-stack">
    {% if section.settings.eyebrow != blank %}
      <p class="ip-kicker">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="ip-heading ip-heading--medium ip-heading--wide">{{ section.settings.heading }}</h2>
    <div class="ip-lede">{{ section.settings.body }}</div>
  </div>

  <div class="ip-addon-grid" style="margin-top: 2rem;">
    {% for block in section.blocks %}
      <article class="ip-card ip-addon-card" {{ block.shopify_attributes }}>
        <p class="ip-addon-card__label">{{ block.settings.price }}</p>
        <h3>{{ block.settings.title }}</h3>
        <p class="ip-note">{{ block.settings.body }}</p>
        {% if block.settings.included_label != blank %}
          <p class="ip-included-label">{{ block.settings.included_label }}</p>
        {% endif %}
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "IP add-ons",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Optional add-ons"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose only the features your family needs."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Both phones can present the same optional add-ons during the purchase flow.</p>"
    }
  ],
  "blocks": [
    {
      "type": "addon",
      "name": "Add-on",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Call Recording"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$5/mo"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Access to 90 days of recorded calls."
        },
        {
          "type": "text",
          "id": "included_label",
          "label": "Included label",
          "default": "Included in the Patriot Package"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IP add-ons",
      "blocks": [
        {
          "type": "addon",
          "settings": {
            "title": "Call Recording",
            "price": "$5/mo",
            "body": "Access to 90 days of recorded calls.",
            "included_label": "Included in the Patriot Package"
          }
        },
        {
          "type": "addon",
          "settings": {
            "title": "Quiet Hours",
            "price": "$5/mo",
            "body": "Set times for when to receive incoming calls.",
            "included_label": "Included in the Patriot Package"
          }
        },
        {
          "type": "addon",
          "settings": {
            "title": "Voicemail to Email",
            "price": "$5/mo",
            "body": "Voicemail messages are sent to email as audio and transcription.",
            "included_label": "Included in the Patriot Package"
          }
        },
        {
          "type": "addon",
          "settings": {
            "title": "Add-on Bundle",
            "price": "$10/mo",
            "body": "Includes all add-ons: Call Recording, Quiet Hours, Voicemail to Email, and Auto Attendant. Saves $10/mo.",
            "included_label": "Included in the Patriot Package"
          }
        },
        {
          "type": "addon",
          "settings": {
            "title": "Auto Attendant",
            "price": "$5/mo",
            "body": "Filter unwanted spam calls.",
            "included_label": "Included in the Patriot Package"
          }
        }
      ]
    }
  ]
}
{% endschema %}
