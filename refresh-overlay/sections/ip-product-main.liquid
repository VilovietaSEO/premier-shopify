{% liquid
  assign is_patriot = false
  if product.handle == 'rugged-phone' or product.handle == 'patriot-phone'
    assign is_patriot = true
  endif

  if is_patriot
    assign fallback_title = 'Rugged Phone'
    assign fallback_price = '$150'
    assign fallback_deck = 'The rugged family phone for busier homes, tougher handling, and longer days.'
    assign fallback_best_for = 'Best for families who want rugged durability, longer battery life, and a more resilient handset.'
    assign fallback_images = 'ip-rugged-phone-buttons.webp|ip-rugged-phone-charger.webp|ip-rugged-phone-back.webp' | split: '|'
  else
    assign fallback_title = 'Classic Phone'
    assign fallback_price = '$100'
    assign fallback_deck = 'The everyday family phone for kids who need to call home without stepping into smartphone life.'
    assign fallback_best_for = 'Best for home, grandparents, short independence windows, and everyday family calling.'
    assign fallback_images = 'ip-classic-phone-buttons.webp|ip-classic-phone-charger.webp|ip-classic-phone-back.webp' | split: '|'
  endif

  assign fallback_media_labels = 'keypad and controls|handset and charging base|back view' | split: '|'

  assign current_variant = product.selected_or_first_available_variant
  assign product_title = product.title | default: fallback_title
  assign product_deck = product.metafields.custom.product_deck.value
  assign best_for = product.metafields.custom.best_for.value | default: fallback_best_for
  assign custom_specs = product.metafields.custom.specs.value | strip
  assign custom_specs_list = custom_specs | split: ';'
  assign service_option_count = 0
  assign addon_option_count = 0
  assign product_info_block_count = 0
  assign default_service_index = 0

  for block in section.blocks
    if block.type == 'service_plan'
      assign service_option_count = service_option_count | plus: 1
      if default_service_index == 0
        assign default_service_index = service_option_count
      endif
      if block.settings.default_selected
        assign default_service_index = service_option_count
      endif
    elsif block.type == 'addon_option'
      assign addon_option_count = addon_option_count | plus: 1
    elsif block.type == 'info_accordion'
      assign product_info_block_count = product_info_block_count | plus: 1
    endif
  endfor
%}

<section class="ip-product-main">
  <div class="ip-product-main__overview">
    <div class="ip-product-main__gallery" data-product-gallery data-gallery-title="{{ product_title | escape }}">
      <div class="ip-product-main__media" aria-live="polite">
        {% if section.settings.use_product_media and product.media.size > 0 %}
          {% for media in product.media %}
            {% assign media_alt = media.alt | default: product_title %}
            <figure
              class="ip-product-main__slide{% if forloop.first %} is-active{% endif %}"
              data-gallery-slide="{{ forloop.index0 }}"
              {% if media.media_type == 'image' %}
                data-gallery-open
                role="button"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                aria-label="Open {{ media_alt | escape }} full view"
              {% endif %}
              {% unless forloop.first %}
                hidden
              {% endunless %}
            >
              {% case media.media_type %}
                {% when 'image' %}
                  {{
                    media
                    | image_url: width: 1400
                    | image_tag:
                      alt: media_alt,
                      loading: 'eager',
                      fetchpriority: 'high',
                      sizes: '(min-width: 990px) 54vw, 100vw'
                  }}
                {% when 'video' %}
                  {{ media | video_tag: controls: true, image_size: '1400x', class: 'ip-product-main__video' }}
                {% when 'external_video' %}
                  {{ media | external_video_tag: class: 'ip-product-main__external-video' }}
                {% else %}
                  {% if media.preview_image %}
                    {{
                      media.preview_image
                      | image_url: width: 1400
                      | image_tag:
                        alt: media_alt,
                        loading: 'eager',
                        fetchpriority: 'high',
                        sizes: '(min-width: 990px) 54vw, 100vw'
                    }}
                  {% endif %}
              {% endcase %}
            </figure>
          {% endfor %}
        {% else %}
          {% for fallback_image in fallback_images %}
            {% assign fallback_label = fallback_media_labels[forloop.index0] %}
            <figure
              class="ip-product-main__slide{% if forloop.first %} is-active{% endif %}"
              data-gallery-slide="{{ forloop.index0 }}"
              data-gallery-open
              role="button"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              aria-label="Open {{ fallback_title }} {{ fallback_label }} full view"
              {% unless forloop.first %}hidden{% endunless %}
            >
              <img
                src="{{ fallback_image | asset_url }}"
                alt="{{ fallback_title }} {{ fallback_label }}"
                width="2000"
                height="1600"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                {% if forloop.first %}fetchpriority="high"{% endif %}
              >
            </figure>
          {% endfor %}
        {% endif %}
      </div>

      {% if section.settings.use_product_media and product.media.size > 1 %}
        <div class="ip-product-main__thumbs" aria-label="{{ product.title | default: fallback_title }} media">
          {% for media in product.media %}
            <button
              class="ip-product-main__thumb{% if forloop.first %} is-active{% endif %}"
              type="button"
              data-gallery-thumb="{{ forloop.index0 }}"
              aria-label="Show {{ product.title | default: fallback_title }} media {{ forloop.index }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              {% if media.preview_image %}
                {{
                  media.preview_image
                  | image_url: width: 220
                  | image_tag:
                    alt: '',
                    loading: 'lazy'
                }}
              {% else %}
                <span>{{ media.media_type | replace: '_', ' ' }}</span>
              {% endif %}
            </button>
          {% endfor %}
        </div>
      {% elsif section.settings.use_product_media == false or product.media.size == 0 %}
        <div class="ip-product-main__thumbs" aria-label="{{ fallback_title }} media">
          {% for fallback_image in fallback_images %}
            {% assign fallback_label = fallback_media_labels[forloop.index0] %}
            <button
              class="ip-product-main__thumb{% if forloop.first %} is-active{% endif %}"
              type="button"
              data-gallery-thumb="{{ forloop.index0 }}"
              aria-label="Show {{ fallback_title }} {{ fallback_label }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              <img src="{{ fallback_image | asset_url }}" alt="" width="220" height="176" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}

      <button class="ip-product-main__full-view" type="button" data-gallery-open>
        Click to see full view
      </button>
    </div>

    <div class="ip-product-main__summary ip-stack">
    <nav class="ip-product-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">◆</span>
      <span>{{ product_title }}</span>
    </nav>

    <p class="ip-kicker">{{ section.settings.eyebrow }}</p>
    <h1 class="ip-heading ip-heading--medium">{{ product_title }}</h1>
    <p class="ip-lede">
      {% if product_deck != blank %}
        {{ product_deck }}
      {% elsif product.description != blank %}
        {{ product.description | strip_html }}
      {% else %}
        {{ fallback_deck }}
      {% endif %}
    </p>
    <a class="ip-product-read-more" href="#ProductInfo-{{ section.id }}">Read more</a>

    <div class="ip-product-purchase-meta">
      {% if current_variant.available %}
        <p class="ip-product-stock">In stock, ready to ship</p>
      {% else %}
        <p class="ip-product-stock ip-product-stock--muted">Currently unavailable</p>
      {% endif %}
      <p class="ip-price">
        {% if product.price %}
          {{ product.price | money }} one-time
        {% else %}
          {{ fallback_price }} one-time
        {% endif %}
      </p>
    </div>

    {% if product != blank %}
      {% form 'product', product, class: 'ip-product-form', data-product-title: product_title %}
        {% if product.has_only_default_variant %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% else %}
          <label for="ProductVariant-{{ section.id }}">Choose an option</label>
          <select id="ProductVariant-{{ section.id }}" name="id">
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant == current_variant %}
                  selected="selected"
                {% endif %}
              >
                {{ variant.title }} - {{ variant.price | money }}
              </option>
            {% endfor %}
          </select>
        {% endif %}

        <input type="hidden" name="properties[Phone]" value="{{ product_title | escape }} - {{ product.price | money | escape }}">

        <label for="Quantity-{{ section.id }}">Quantity</label>
        <input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1">

        {% if service_option_count > 0 or addon_option_count > 0 %}
          <div class="ip-product-options">
            {% if section.settings.purchase_options_heading != blank %}
              <h2>{{ section.settings.purchase_options_heading }}</h2>
            {% endif %}

            {% if service_option_count > 0 %}
              <fieldset class="ip-choice-group">
                <legend>{{ section.settings.service_options_heading }}</legend>
                {% assign service_option_index = 0 %}
                {% for block in section.blocks %}
                  {% if block.type == 'service_plan' %}
                    {% assign billing_variant = block.settings.billing_product.selected_or_first_available_variant %}
                    {% assign service_option_index = service_option_index | plus: 1 %}
                    {% assign service_value = block.settings.title | append: ' - ' | append: block.settings.price %}
                    {% assign service_input_id = 'ServiceOption-' | append: section.id | append: '-' | append: service_option_index %}
                    <label class="ip-choice" for="{{ service_input_id }}" {{ block.shopify_attributes }}>
                      <input
                        id="{{ service_input_id }}"
                        type="radio"
                        name="properties[Service plan]"
                        value="{{ service_value | escape }}"
                        data-billing-variant="{{ billing_variant.id }}"
                        data-billing-role="service"
                        {% if service_option_index == default_service_index %}
                          checked
                        {% endif %}
                      >
                      <span>
                        <strong>{{ block.settings.title }}</strong>
                        <small>{{ block.settings.price }}</small>
                      </span>
                    </label>
                  {% endif %}
                {% endfor %}
              </fieldset>
            {% endif %}

            {% if addon_option_count > 0 %}
              <fieldset class="ip-choice-group">
                <legend>{{ section.settings.addon_options_heading }}</legend>
                {% assign addon_option_index = 0 %}
                {% for block in section.blocks %}
                  {% if block.type == 'addon_option' %}
                    {% assign billing_variant = block.settings.billing_product.selected_or_first_available_variant %}
                    {% assign addon_option_index = addon_option_index | plus: 1 %}
                    {% assign addon_input_id = 'AddonOption-' | append: section.id | append: '-' | append: addon_option_index %}
                    <label class="ip-choice" for="{{ addon_input_id }}" {{ block.shopify_attributes }}>
                      <input
                        id="{{ addon_input_id }}"
                        type="checkbox"
                        name="properties[{{ block.settings.title | escape }}]"
                        value="{{ block.settings.price | escape }}"
                        data-billing-variant="{{ billing_variant.id }}"
                        data-billing-role="addon"
                      >
                      <span>
                        <strong>{{ block.settings.title }}</strong>
                        <small>{{ block.settings.price }}</small>
                      </span>
                    </label>
                  {% endif %}
                {% endfor %}
              </fieldset>
            {% endif %}

            {% if section.settings.purchase_options_note != blank %}
              <p class="ip-form-note">{{ section.settings.purchase_options_note }}</p>
            {% endif %}
          </div>
        {% endif %}

        <p class="ip-form-note ip-product-main__legal">
          Review the
          <a href="/policies/privacy-policy" target="_blank" rel="noopener">Privacy Policy</a>
          and
          <a href="/policies/terms-of-service" target="_blank" rel="noopener">Terms and Conditions</a>.
          Acceptance is collected once at final checkout.
        </p>

        <button
          type="submit"
          data-add-to-cart-button
          data-default-text="{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}"
          {% unless current_variant.available %}
            disabled
          {% endunless %}
        >
          {% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}
        </button>

        <p class="ip-form-note" data-cart-status aria-live="polite" hidden></p>

        {% if section.settings.show_dynamic_checkout %}
          {{ form | payment_button }}
        {% endif %}
      {% endform %}
    {% endif %}
  </div>
  </div>

  {% if product_info_block_count > 0 %}
    <div id="ProductInfo-{{ section.id }}" class="ip-product-accordions" aria-label="{{ section.settings.product_info_heading | escape }}">
      {% if section.settings.product_info_heading != blank %}
        <h2>{{ section.settings.product_info_heading }}</h2>
      {% endif %}

      {% for block in section.blocks %}
        {% if block.type == 'info_accordion' %}
          <details
            class="ip-product-accordion"
            {% if block.settings.open_by_default %}
              open
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <summary>{{ block.settings.title }}</summary>
            <div class="ip-product-accordion__body">
              {% case block.settings.source %}
                {% when 'best_for' %}
                  {% if block.settings.body != blank %}
                    {{ block.settings.body }}
                  {% else %}
                    <p>{{ best_for }}</p>
                  {% endif %}

                {% when 'specs' %}
                  {% if block.settings.body != blank %}
                    {{ block.settings.body }}
                  {% endif %}
                  <ul class="ip-spec-list">
                    {% if custom_specs != blank %}
                      {% for spec in custom_specs_list %}
                        {% assign spec_text = spec | strip %}
                        {% if spec_text != blank %}
                          <li>{{ spec_text }}</li>
                        {% endif %}
                      {% endfor %}
                    {% elsif is_patriot %}
                      <li>Rugged cordless Wi-Fi handset with charging base</li>
                      <li>Waterproof and dust-proof, drop-proof up to 1.8 meters</li>
                      <li>Non-slip, anti-scratch, anti-bacterial construction</li>
                      <li>HD Voice, AI Noise Cancellation, and Acoustic Shield</li>
                      <li>Encrypted data transmission and storage</li>
                      <li>Built-in Bluetooth 5.0</li>
                      <li>13-hour talk time, 300-hour standby battery</li>
                    {% else %}
                      <li>Heavy-duty cordless Wi-Fi handset with charging base</li>
                      <li>HD audio quality</li>
                      <li>Smart noise filtering</li>
                      <li>Encrypted data transmission and storage</li>
                      <li>Built-in Bluetooth 5.0</li>
                      <li>9-hour talk time, 200-hour standby battery</li>
                    {% endif %}
                  </ul>

                {% when 'service_addons' %}
                  {% if block.settings.body != blank %}
                    {{ block.settings.body }}
                  {% else %}
                    <p>Service: personal phone number + monthly service is $17.76/mo. Annual service is $200/yr and saves $13.12.</p>
                  {% endif %}
                  {% if addon_option_count > 0 %}
                    <ul class="ip-addon-list">
                      {% for addon_block in section.blocks %}
                        {% if addon_block.type == 'addon_option' %}
                          <li>
                            <strong>{{ addon_block.settings.title }}</strong>
                            <span>{{ addon_block.settings.price }}</span>
                          </li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  {% endif %}

                {% when 'shipping_setup' %}
                  {% if block.settings.body != blank %}
                    {{ block.settings.body }}
                  {% else %}
                    <p>Shipping: one $15 charge per order in the USA.</p>
                    <p>Applicable tax is calculated after the customer enters an address.</p>
                    <p>Service and add-on selections are captured as $0.00 deferred-billing lines with their future-charge details.</p>
                  {% endif %}

                {% else %}
                  {% if block.settings.body != blank %}
                    {{ block.settings.body }}
                  {% endif %}
              {% endcase %}
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "IP product main",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_product_media",
      "label": "Use Shopify product media instead of supplied studio images",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A phone that acts like a phone"
    },
    {
      "type": "text",
      "id": "purchase_options_heading",
      "label": "Purchase options heading",
      "default": "Choose service and add-ons"
    },
    {
      "type": "text",
      "id": "service_options_heading",
      "label": "Service options heading",
      "default": "Service plan"
    },
    {
      "type": "text",
      "id": "addon_options_heading",
      "label": "Add-on options heading",
      "default": "Optional add-ons"
    },
    {
      "type": "text",
      "id": "product_info_heading",
      "label": "Product information heading",
      "default": "Product information"
    },
    {
      "type": "textarea",
      "id": "purchase_options_note",
      "label": "Purchase options note",
      "default": "Service and add-on selections are captured with the order and added as billing items when the matching products are configured."
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout buttons",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "service_plan",
      "name": "Service plan option",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Monthly service"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$17.76/mo"
        },
        {
          "type": "product",
          "id": "billing_product",
          "label": "Billing product"
        },
        {
          "type": "checkbox",
          "id": "default_selected",
          "label": "Selected by default",
          "default": false
        }
      ]
    },
    {
      "type": "addon_option",
      "name": "Add-on option",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Call Recording"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$5/mo"
        },
        {
          "type": "product",
          "id": "billing_product",
          "label": "Billing product"
        }
      ]
    },
    {
      "type": "info_accordion",
      "name": "Product info accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product information"
        },
        {
          "type": "select",
          "id": "source",
          "label": "Content source",
          "default": "custom",
          "options": [
            {
              "value": "best_for",
              "label": "Best for metafield"
            },
            {
              "value": "specs",
              "label": "Specs metafield"
            },
            {
              "value": "service_addons",
              "label": "Service and add-ons"
            },
            {
              "value": "shipping_setup",
              "label": "Shipping and setup"
            },
            {
              "value": "custom",
              "label": "Custom rich text"
            }
          ]
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
