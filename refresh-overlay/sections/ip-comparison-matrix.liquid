<section class="ip-section ip-section--surface">
  <div class="ip-stack">
    {% if section.settings.eyebrow != blank %}
      <p class="ip-kicker">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="ip-heading ip-heading--medium ip-heading--wide">{{ section.settings.heading }}</h2>
    <div class="ip-lede">{{ section.settings.body }}</div>
  </div>

  <div class="ip-matrix" style="margin-top: 2rem;">
    <div class="ip-matrix__row">
      <div class="ip-matrix__cell ip-matrix__cell--head">Question</div>
      <div class="ip-matrix__cell ip-matrix__cell--head">Independence Phone</div>
      <div class="ip-matrix__cell ip-matrix__cell--head">Restricted smartphone</div>
      <div class="ip-matrix__cell ip-matrix__cell--head">Flip phone</div>
      <div class="ip-matrix__cell ip-matrix__cell--head">Landline</div>
    </div>
    {% for block in section.blocks %}
      <div class="ip-matrix__row" {{ block.shopify_attributes }}>
        <div class="ip-matrix__cell ip-matrix__feature">{{ block.settings.feature }}</div>
        <div class="ip-matrix__cell">{{ block.settings.independence }}</div>
        <div class="ip-matrix__cell">{{ block.settings.smartphone }}</div>
        <div class="ip-matrix__cell">{{ block.settings.flip }}</div>
        <div class="ip-matrix__cell">{{ block.settings.landline }}</div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "IP comparison matrix",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why not the usual options?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A simpler middle path before a smartphone."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Parents are not just comparing devices. They are comparing how much access, negotiation, and monthly complexity each choice brings into the home.</p>"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature",
          "default": "Primary job"
        },
        {
          "type": "textarea",
          "id": "independence",
          "label": "Independence Phone",
          "default": "Calling and family reachability"
        },
        {
          "type": "textarea",
          "id": "smartphone",
          "label": "Restricted smartphone",
          "default": "Full smartphone ecosystem with restrictions"
        },
        {
          "type": "textarea",
          "id": "flip",
          "label": "Flip phone",
          "default": "Simpleer hardware, often with carrier/browser complexity"
        },
        {
          "type": "textarea",
          "id": "landline",
          "label": "Landline",
          "default": "Familiar calling, tied to one home line"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IP comparison matrix",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "feature": "Primary job",
            "independence": "Calling and family reachability",
            "smartphone": "Full smartphone ecosystem with restrictions",
            "flip": "Simpler hardware, often with carrier/browser complexity",
            "landline": "Familiar calling, tied to one home line"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Apps and feeds",
            "independence": "Not part of the product promise",
            "smartphone": "Built into the ecosystem",
            "flip": "Varies by model and carrier",
            "landline": "No"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Web browser",
            "independence": "No web browser positioning",
            "smartphone": "Usually available unless locked down",
            "flip": "Often available in some form",
            "landline": "No"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Recurring cost",
            "independence": "$17.76/mo or $200/yr service",
            "smartphone": "Device plus mobile plan",
            "flip": "Device plus mobile plan",
            "landline": "Provider-dependent"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Family fit",
            "independence": "Made for the smartphone-free years",
            "smartphone": "Powerful, but more than many families want yet",
            "flip": "Simple, but less purpose-built for this parent conflict",
            "landline": "Familiar, but less flexible as a modern product"
          }
        }
      ]
    }
  ]
}
{% endschema %}
