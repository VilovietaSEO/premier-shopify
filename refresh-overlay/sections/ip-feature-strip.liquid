<section class="ip-section ip-section--surface ip-section--tight ip-section--flag ip-feature-strip full-width">
  <div class="ip-strip">
    <div class="ip-stack ip-strip__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="ip-kicker">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="ip-heading ip-heading--medium">{{ section.settings.heading }}</h2>
    </div>
    <div class="ip-strip__items">
      {% for block in section.blocks %}
        <div class="ip-strip__item" {{ block.shopify_attributes }}>
          <span class="ip-strip__icon" aria-hidden="true">
            {% case forloop.index %}
              {% when 1 %}
                <img src="{{ 'ip-tool-icon-auto-attendant.svg' | asset_url }}" alt="" width="64" height="64" loading="lazy">
              {% when 2 %}
                <img src="{{ 'ip-tool-icon-call-recording.svg' | asset_url }}" alt="" width="64" height="64" loading="lazy">
              {% else %}
                <img src="{{ 'ip-tool-icon-phone-times.svg' | asset_url }}" alt="" width="64" height="64" loading="lazy">
            {% endcase %}
          </span>
          <h3>{{ block.settings.title }}</h3>
          <p class="ip-note">{{ block.settings.body }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IP feature strip",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Parent tools that feel immediately useful"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real phone tools without smartphone drama."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Calling"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Built around connection, not entertainment."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IP feature strip",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Auto Attendant Call Screening",
            "body": "Help screen unwanted calls before they interrupt the family phone."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Call Recording",
            "body": "Keep a 90-day call record when your family needs extra visibility."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Programmable On/Off Phone Times",
            "body": "Set times for when incoming calls can ring through."
          }
        }
      ]
    }
  ]
}
{% endschema %}
