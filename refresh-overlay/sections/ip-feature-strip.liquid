<section class="ip-section ip-section--surface ip-section--tight ip-section--flag ip-feature-strip full-width">
  <div class="ip-strip">
    <div class="ip-stack ip-strip__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="ip-kicker">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="ip-heading ip-heading--medium">{{ section.settings.heading }}</h2>
    </div>
    <div class="ip-strip__items">
      {% for block in section.blocks %}
        {% liquid
          assign icon_name = block.settings.icon
          if icon_name == blank
            case forloop.index
              when 1
                assign icon_name = 'shield_check'
              when 2
                assign icon_name = 'microphone'
              else
                assign icon_name = 'clock'
            endcase
          endif
        %}
        <div class="ip-strip__item" {{ block.shopify_attributes }}>
          <span class="ip-strip__icon" aria-hidden="true">
            {% case icon_name %}
              {% when 'microphone' %}
                {{ 'ip-tool-icon-call-recording.svg' | inline_asset_content }}
              {% when 'clock' %}
                {{ 'ip-tool-icon-phone-times.svg' | inline_asset_content }}
              {% else %}
                {{ 'ip-tool-icon-auto-attendant.svg' | inline_asset_content }}
            {% endcase %}
          </span>
          <h3>{{ block.settings.title }}</h3>
          <p class="ip-note">{{ block.settings.body }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IP feature strip",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Parent tools that feel immediately useful"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real phone tools without smartphone drama."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Calling"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Built around connection, not entertainment."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield_check",
          "options": [
            {
              "value": "shield_check",
              "label": "Shield check"
            },
            {
              "value": "microphone",
              "label": "Microphone"
            },
            {
              "value": "clock",
              "label": "Clock"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IP feature strip",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Auto Attendant Call Screening",
            "icon": "shield_check",
            "body": "Help screen unwanted calls before they interrupt the family phone."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Call Recording",
            "icon": "microphone",
            "body": "Keep a 90-day call record when your family needs extra visibility."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Programmable On/Off Phone Times",
            "icon": "clock",
            "body": "Set times for when incoming calls can ring through."
          }
        }
      ]
    }
  ]
}
{% endschema %}
