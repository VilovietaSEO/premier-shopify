[Unit]
Description=Patriot Phone storefront ops service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/patriot-phone/shopify
Environment=NODE_ENV=production
Environment=PORT=8786
Environment=CRM_SUBMISSIONS_PATH=/opt/patriot-phone/data/crm-submissions.jsonl
Environment=CRM_STORE_TIMEZONE=America/Denver
Environment=LLMS_SITE_URL=https://jordan-mark-premier.myshopify.com
Environment=LLMS_TIME_ZONE=America/Denver
EnvironmentFile=-/etc/patriot-phone-ops.env
ExecStart=/usr/bin/npm run ops:server
Restart=always
RestartSec=5
User=patriot-phone
Group=patriot-phone
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/patriot-phone/data

[Install]
WantedBy=multi-user.target
