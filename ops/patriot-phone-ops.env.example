# Copy to /etc/patriot-phone-ops.env on the persistent host.
# Do not commit or share the real token.

CRM_VIEWER_TOKEN=replace-with-a-random-token-at-least-24-characters
CRM_ORDER_INGEST_TOKEN=replace-with-a-different-random-token-at-least-24-characters
SHOPIFY_ORDER_WEBHOOK_SECRET=replace-with-the-shopify-order-webhook-secret

# Optional outbound webhooks for downstream CRM/automation systems.
# Comma-separated or newline-separated https:// URLs are supported.
CRM_LEAD_WEBHOOK_URLS=
CRM_SALE_WEBHOOK_URLS=
CRM_WEBHOOK_SECRET=replace-with-a-random-outbound-signing-secret-at-least-24-characters

# Optional Rev.io checkout handoff. Point this at the API implementer's middleware.
REVIO_CHECKOUT_WEBHOOK_URLS=
REVIO_WEBHOOK_SECRET=replace-with-a-random-revio-signing-secret-at-least-24-characters
REVIO_CHECKOUT_SUCCESS_URL=
REVIO_CHECKOUT_ALLOWED_ORIGINS=https://jordan-mark-premier.myshopify.com
