<header>
  <h2 class="header__title">
    <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 520 | image_tag: class: 'header__logo', loading: 'eager' }}
      {% else %}
        <img
          class="header__logo"
          src="{{ 'ip-independence-phone-logo.png' | asset_url }}"
          alt="{{ shop.name | escape }}"
          width="1562"
          height="422"
          loading="eager"
        >
      {% endif %}
    </a>
  </h2>

  <nav class="header__icons" aria-label="Store actions">
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a class="header__icon-link" href="{{ routes.root_url }}pages/contact" aria-label="Contact">
      {{ 'icon-contact.svg' | inline_asset_content }}
    </a>

    <a class="header__icon-link" href="{{ routes.cart_url }}" aria-label="Cart">
      <sup data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</sup>
      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </nav>
</header>

{% stylesheet %}
  header {
    --ip-header-row: 3.75rem;
    align-items: center;
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    height: auto;
    justify-content: space-between;
    min-height: var(--ip-header-row);
  }
  header .header__title {
    align-items: center;
    display: flex;
    flex: 0 1 auto;
    min-height: var(--ip-header-row);
  }
  header a {
    align-items: center;
    color: var(--color-foreground);
    display: inline-flex;
    justify-content: center;
    min-height: var(--ip-header-row);
    padding-block: 0;
    position: relative;
    text-decoration: none;
  }
  header a sup {
    align-items: center;
    background: var(--ip-red, #B73532);
    border-radius: 999px;
    color: #fff;
    display: inline-flex;
    font-size: 0.68rem;
    font-weight: 900;
    justify-content: center;
    line-height: 1;
    min-height: 1.12rem;
    min-width: 1.12rem;
    position: absolute;
    right: -0.35rem;
    top: 0.25rem;
    overflow: hidden;
    padding: 0 0.32rem;
  }
  header svg {
    width: 2rem;
  }
  header .header__icons {
    align-items: center;
    display: flex;
    gap: 0.45rem;
    margin-left: auto;
    min-height: var(--ip-header-row);
  }
  header .header__icon-link,
  header shopify-account {
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--ip-ink, #172033) 12%, transparent);
    border-radius: 6px;
    color: var(--color-foreground);
    display: inline-flex;
    height: 2.75rem;
    justify-content: center;
    min-height: 2.75rem;
    width: 2.75rem;
  }
  header .header__icon-link svg,
  header shopify-account svg {
    height: 1.35rem;
    width: 1.35rem;
  }
  header .header__icon-link:hover,
  header shopify-account:hover {
    border-color: color-mix(in srgb, var(--ip-blue, #263F73) 36%, transparent);
    color: var(--ip-blue, #263F73);
  }
  @media (max-width: 820px) {
    header {
      --ip-header-row: 3.5rem;
    }
    header .header__icons {
      gap: 0.35rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
