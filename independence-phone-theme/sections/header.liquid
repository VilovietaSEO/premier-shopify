<header>
  <h2 class="header__title">
    <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 520 | image_tag: class: 'header__logo', loading: 'eager' }}
      {% else %}
        <img
          class="header__logo"
          src="{{ 'ip-independence-phone-logo.png' | asset_url }}"
          alt="{{ shop.name | escape }}"
          width="1562"
          height="422"
          loading="eager"
        >
      {% endif %}
    </a>
  </h2>

  <nav class="header__menu" aria-label="Main menu">
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        {{ link.title | link_to: link.url }}
      {% endfor %}
    {% else %}
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ routes.collections_url }}/phones">Choose Your Phone</a>
      <a href="{{ routes.root_url }}pages/contact">Contact</a>
    {% endif %}
  </nav>

  <details class="header__drawer">
    <summary aria-label="Open menu">
      <span class="header__drawer-lines" aria-hidden="true"></span>
    </summary>
    <nav class="header__drawer-menu" aria-label="Mobile menu">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          {{ link.title | link_to: link.url }}
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}">Home</a>
        <a href="{{ routes.collections_url }}/phones">Choose Your Phone</a>
        <a href="{{ routes.root_url }}pages/contact">Contact</a>
      {% endif %}
    </nav>
  </details>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}" aria-label="Cart">
      <sup data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</sup>
      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% stylesheet %}
  header {
    --ip-header-row: 3.75rem;
    align-items: center;
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    height: auto;
    justify-content: space-between;
    min-height: var(--ip-header-row);
  }
  header .header__title {
    align-items: center;
    display: flex;
    flex: 0 1 auto;
    min-height: var(--ip-header-row);
  }
  header a {
    align-items: center;
    color: var(--color-foreground);
    display: inline-flex;
    justify-content: center;
    min-height: var(--ip-header-row);
    padding-block: 0;
    position: relative;
    text-decoration: none;
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header svg {
    width: 2rem;
  }
  header .header__menu,
  header .header__icons {
    align-items: center;
    display: flex;
    gap: clamp(0.8rem, 2vw, 1.25rem);
    min-height: var(--ip-header-row);
  }
  header .header__drawer {
    align-items: center;
    display: none;
    justify-content: center;
    min-height: var(--ip-header-row);
  }
  header .header__drawer summary {
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--ip-ink, #172033) 14%, transparent);
    border-radius: 6px;
    cursor: pointer;
    display: inline-flex;
    height: 2.75rem;
    justify-content: center;
    list-style: none;
    width: 2.75rem;
  }
  header .header__drawer summary::-webkit-details-marker {
    display: none;
  }
  header .header__drawer-lines,
  header .header__drawer-lines::before,
  header .header__drawer-lines::after {
    background: currentcolor;
    border-radius: 999px;
    content: "";
    display: block;
    height: 2px;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
    width: 1.15rem;
  }
  header .header__drawer-lines {
    position: relative;
  }
  header .header__drawer-lines::before,
  header .header__drawer-lines::after {
    left: 0;
    position: absolute;
  }
  header .header__drawer-lines::before {
    transform: translateY(-6px);
  }
  header .header__drawer-lines::after {
    transform: translateY(6px);
  }
  header .header__drawer[open] .header__drawer-lines {
    background: transparent;
  }
  header .header__drawer[open] .header__drawer-lines::before {
    transform: rotate(45deg);
  }
  header .header__drawer[open] .header__drawer-lines::after {
    transform: rotate(-45deg);
  }
  header .header__drawer-menu {
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--ip-ink, #172033) 12%, transparent);
    border-radius: 8px;
    display: grid;
    gap: 0.25rem;
    left: var(--page-margin);
    padding: 0.55rem;
    position: absolute;
    right: var(--page-margin);
    top: calc(100% + 0.55rem);
    z-index: 35;
  }
  header .header__drawer-menu a {
    align-items: center;
    border-radius: 6px;
    display: flex;
    font-weight: 900;
    justify-content: flex-start;
    min-height: 3rem;
    padding: 0.72rem 0.85rem;
  }
  @media (max-width: 820px) {
    header {
      --ip-header-row: 3.5rem;
    }
    header .header__menu {
      display: none;
    }
    header .header__drawer {
      display: flex;
      margin-left: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
