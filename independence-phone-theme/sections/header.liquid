{% assign public_brand_name = settings.ip_brand_name | default: 'INDEPENDENCE PHONE' %}
{% assign customer_cart_count = 0 %}
{% for header_item in cart.items %}
  {% assign header_setup_id = '' %}
  {% assign header_is_setup_child = false %}
  {% for header_property in header_item.properties %}
    {% if header_property.first == '_setup_id' %}
      {% assign header_setup_id = header_property.last %}
    {% elsif header_property.first == '_setup_parent' and header_property.last == 'true' %}
      {% assign header_is_setup_child = true %}
    {% endif %}
  {% endfor %}

  {% assign header_child_has_parent = false %}
  {% if header_is_setup_child and header_setup_id != blank %}
    {% for header_candidate in cart.items %}
      {% assign header_candidate_setup_id = '' %}
      {% assign header_candidate_is_child = false %}
      {% for header_candidate_property in header_candidate.properties %}
        {% if header_candidate_property.first == '_setup_id' %}
          {% assign header_candidate_setup_id = header_candidate_property.last %}
        {% elsif header_candidate_property.first == '_setup_parent' and header_candidate_property.last == 'true' %}
          {% assign header_candidate_is_child = true %}
        {% endif %}
      {% endfor %}
      {% if header_candidate_is_child == false and header_candidate_setup_id == header_setup_id %}
        {% assign header_child_has_parent = true %}
        {% break %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% if header_is_setup_child == false or header_child_has_parent == false %}
    {% assign customer_cart_count = customer_cart_count | plus: header_item.quantity %}
  {% endif %}
{% endfor %}

<header class="full-width">
  <h2 class="header__title">
    <a href="{{ routes.root_url }}" aria-label="{{ public_brand_name | escape }}">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 520 | image_tag: class: 'header__logo', loading: 'eager' }}
      {% else %}
        <img
          class="header__logo"
          src="{{ 'ip-independence-phone-logo.png' | asset_url }}"
          alt="{{ public_brand_name | escape }}"
          width="1562"
          height="422"
          loading="eager"
        >
      {% endif %}
    </a>
  </h2>

  <nav class="header__icons" aria-label="Store actions">
    <a class="header__icon-link" href="{{ routes.root_url }}pages/faq" aria-label="Frequently asked questions">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M9.75 9a2.35 2.35 0 1 1 3.5 2.05c-.8.45-1.25.88-1.25 1.95"></path>
        <path d="M12 16.6v.15"></path>
      </svg>
    </a>

    <a class="header__icon-link" href="{{ routes.root_url }}pages/contact" aria-label="Contact">
      {{ 'icon-contact.svg' | inline_asset_content }}
    </a>

    <a class="header__icon-link" href="{{ routes.cart_url }}" aria-label="Cart">
      <sup data-cart-count {% if customer_cart_count == 0 %}hidden{% endif %}>{{ customer_cart_count }}</sup>
      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </nav>
</header>

{% stylesheet %}
  header {
    --ip-header-row: 4.5rem;
    align-items: center;
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    height: auto;
    justify-content: space-between;
    min-height: var(--ip-header-row);
  }
  header .header__title {
    align-items: center;
    display: flex;
    flex: 0 1 auto;
    min-height: var(--ip-header-row);
  }
  header a {
    align-items: center;
    color: var(--color-foreground);
    display: inline-flex;
    justify-content: center;
    min-height: var(--ip-header-row);
    padding-block: 0;
    position: relative;
    text-decoration: none;
  }
  header a sup {
    align-items: center;
    background: var(--ip-red, #B73532);
    border-radius: 999px;
    color: #fff;
    display: inline-flex;
    font-size: 0.68rem;
    font-weight: 900;
    justify-content: center;
    line-height: 1;
    min-height: 1.12rem;
    min-width: 1.12rem;
    position: absolute;
    right: -0.35rem;
    top: 0.25rem;
    overflow: hidden;
    padding: 0 0.32rem;
  }
  header svg {
    width: 2rem;
  }
  header .header__icons {
    align-items: center;
    display: flex;
    gap: 0.45rem;
    margin-left: auto;
    min-height: var(--ip-header-row);
  }
  header .header__icon-link,
  header shopify-account {
    align-items: center;
    background: transparent;
    border: 0;
    border-radius: 999px;
    color: var(--ip-red, #B73532);
    display: inline-flex;
    height: 2.75rem;
    justify-content: center;
    min-height: 2.75rem;
    position: relative;
    width: 2.75rem;
  }
  header .header__icon-link svg,
  header shopify-account svg {
    height: 1.35rem;
    width: 1.35rem;
  }
  header .header__icon-link:hover,
  header shopify-account:hover {
    color: color-mix(in srgb, var(--ip-red, #B73532) 82%, #172033);
  }
  @media (max-width: 820px) {
    header {
      --ip-header-row: 4rem;
    }
    header .header__icons {
      gap: 0.35rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "paragraph",
      "content": "The question-mark icon links to the FAQ page."
    }
  ]
}
{% endschema %}
