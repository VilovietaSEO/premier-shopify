<footer>
  <div class="footer__copyright">
    <a class="footer__brand" href="{{ routes.root_url }}">{{ shop.name }}</a>
    <small>&copy; {{ 'now' | date: '%Y' }}</small>
    <p>{{ section.settings.footer_note }}</p>
  </div>

  <nav class="footer__links" aria-label="Footer menu">
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        {{ link.title | link_to: link.url }}
      {% endfor %}
    {% else %}
      <a href="{{ routes.collections_url }}/phones">Choose Your Phone</a>
      <a href="{{ routes.root_url }}pages/contact">Contact</a>
      <a href="{{ routes.root_url }}policies/privacy-policy">Privacy</a>
      <a href="{{ routes.root_url }}policies/terms-of-service">Terms</a>
    {% endif %}
  </nav>

  <div class="footer__payment">
    {% if section.settings.show_payment_icons %}
      {% for type in shop.enabled_payment_types %}
        {{ type | payment_type_svg_tag }}
      {% endfor %}
    {% endif %}
  </div>
</footer>

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "textarea",
      "id": "footer_note",
      "label": "Footer note",
      "default": "American-owned and family-focused. Built for the smartphone-free years."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
