{% liquid
  assign freedom = section.settings.freedom_product
  assign patriot = section.settings.patriot_product
  assign freedom_summary = freedom.metafields.custom.best_for.value | default: section.settings.freedom_summary
  assign patriot_summary = patriot.metafields.custom.best_for.value | default: section.settings.patriot_summary
  assign freedom_specs = freedom.metafields.custom.specs.value | strip
  assign patriot_specs = patriot.metafields.custom.specs.value | strip
  assign freedom_specs_list = freedom_specs | split: ';'
  assign patriot_specs_list = patriot_specs | split: ';'
  assign freedom_title = freedom.title | default: 'Classic Phone'
  assign patriot_title = patriot.title | default: 'Rugged Phone'
%}

<section class="ip-section ip-product-comparison">
  <div class="ip-stack">
    {% if section.settings.eyebrow != blank %}
      <p class="ip-kicker">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="ip-heading ip-heading--medium ip-heading--wide">{{ section.settings.heading }}</h2>
    <div class="ip-lede">{{ section.settings.body }}</div>
  </div>

  <div class="ip-products ip-products--comparison">
    <article class="ip-card ip-product-card">
      {% render 'ip-product-card-gallery',
        card_product: freedom,
        fallback_title: freedom_title,
        fallback_image: section.settings.freedom_image,
        fallback_asset: 'ip-current-site-product-1.png',
        block_type: 'standard_gallery_image',
        gallery_blocks: section.blocks
      %}
      <div class="ip-product-card__body">
        <div class="ip-product-card__meta">
          <h3>{{ freedom_title }}</h3>
          <p class="ip-price">{% if freedom.price %}{{ freedom.price | money }}{% else %}$100{% endif %}</p>
        </div>
        <p>{{ freedom_summary }}</p>
        <ul class="ip-spec-list">
          {% if freedom_specs != blank %}
            {% for spec in freedom_specs_list %}
              {% assign spec_text = spec | strip %}
              {% if spec_text != blank %}
                <li>{{ spec_text }}</li>
              {% endif %}
            {% endfor %}
          {% else %}
            <li>Heavy-duty cordless Wi-Fi handset with charging base</li>
            <li>HD audio quality and smart noise filtering</li>
            <li>Bluetooth 5.0, encrypted data transmission and storage</li>
            <li>9-hour talk time, 200-hour standby battery</li>
          {% endif %}
        </ul>
        <div class="ip-buttons">
          <a class="ip-button" href="{% if freedom.url %}{{ freedom.url }}{% else %}/products/standard-phone{% endif %}">
            View Classic Phone
          </a>
        </div>
      </div>
    </article>

    <article class="ip-card ip-product-card">
      {% render 'ip-product-card-gallery',
        card_product: patriot,
        fallback_title: patriot_title,
        fallback_image: section.settings.patriot_image,
        fallback_asset: 'ip-current-site-product-2.png',
        block_type: 'rugged_gallery_image',
        gallery_blocks: section.blocks
      %}
      <div class="ip-product-card__body">
        <div class="ip-product-card__meta">
          <h3>{{ patriot_title }}</h3>
          <p class="ip-price">{% if patriot.price %}{{ patriot.price | money }}{% else %}$150{% endif %}</p>
        </div>
        <p>{{ patriot_summary }}</p>
        <ul class="ip-spec-list">
          {% if patriot_specs != blank %}
            {% for spec in patriot_specs_list %}
              {% assign spec_text = spec | strip %}
              {% if spec_text != blank %}
                <li>{{ spec_text }}</li>
              {% endif %}
            {% endfor %}
          {% else %}
            <li>Rugged cordless Wi-Fi handset with charging base</li>
            <li>Waterproof, dust-proof, and drop-proof up to 1.8 meters</li>
            <li>HD Voice, AI Noise Cancellation, and Acoustic Shield</li>
            <li>13-hour talk time, 300-hour standby battery</li>
          {% endif %}
        </ul>
        <div class="ip-buttons">
          <a class="ip-button" href="{% if patriot.url %}{{ patriot.url }}{% else %}/products/rugged-phone{% endif %}">
            View Rugged Phone
          </a>
        </div>
      </div>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "IP product comparison",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Two phone styles. One simple decision."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compare the everyday model and the rugged model."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Both phones are cordless Wi-Fi handsets with charging bases. Both are built around simple family calling, not apps or feeds.</p>"
    },
    {
      "type": "product",
      "id": "freedom_product",
      "label": "Classic Phone product"
    },
    {
      "type": "image_picker",
      "id": "freedom_image",
      "label": "Standard fallback image"
    },
    {
      "type": "textarea",
      "id": "freedom_summary",
      "label": "Standard summary",
      "default": "Best for home, grandparents, short independence windows, and everyday family calling."
    },
    {
      "type": "product",
      "id": "patriot_product",
      "label": "Rugged Phone product"
    },
    {
      "type": "image_picker",
      "id": "patriot_image",
      "label": "Rugged fallback image"
    },
    {
      "type": "textarea",
      "id": "patriot_summary",
      "label": "Rugged summary",
      "default": "Best for families who want rugged durability, longer battery life, and a more resilient handset."
    }
  ],
  "blocks": [
    {
      "type": "standard_gallery_image",
      "name": "Standard gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "rugged_gallery_image",
      "name": "Rugged gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IP product comparison"
    }
  ]
}
{% endschema %}
