{% liquid
  assign hero_poster = 'ip-hero-video-poster.jpg' | asset_url
  if section.settings.poster_image != blank
    assign hero_poster = section.settings.poster_image | image_url: width: 2200
  endif
%}

<section class="ip-hero full-width" data-hero-video>
  <div class="ip-hero__media">
    {% if section.settings.hero_video != blank %}
      {{
        section.settings.hero_video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'ip-hero__video'
      }}
    {% else %}
      <video
        class="ip-hero__video"
        autoplay
        loop
        muted
        playsinline
        poster="{{ hero_poster }}"
      >
        <source src="{{ 'ip-hero-video.mp4' | asset_url }}" type="video/mp4">
      </video>
    {% endif %}
  </div>

  {% if section.settings.sound_label != blank %}
    <button
      class="ip-hero__sound"
      type="button"
      data-hero-sound-toggle
      aria-label="{{ section.settings.sound_label | escape }}"
      aria-pressed="false"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M11 5 6.5 9H3v6h3.5l4.5 4V5Z"></path>
        <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
        <path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
      </svg>
    </button>
  {% endif %}

  <div class="ip-hero__inner">
    {% if section.settings.proof_line != blank %}
      <p class="ip-hero__proof">{{ section.settings.proof_line }}</p>
    {% endif %}

    <div class="ip-hero__copy">
      {% if section.settings.heading != blank %}
        <h1 class="ip-heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="ip-lede">{{ section.settings.subheading }}</div>
      {% endif %}

      {% if section.settings.price_callout != blank %}
        <p class="ip-hero__price">{{ section.settings.price_callout }}</p>
      {% endif %}

      <div class="ip-buttons">
        {% if section.settings.primary_label != blank %}
          <a class="ip-button" href="{{ section.settings.primary_link | default: '/collections/all' }}">
            {{ section.settings.primary_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IP video hero",
  "settings": [
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero video"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Give them a phone. Not the internet."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Kids can call home without apps, browsers, social media, or a personal screen. Built for bus days, home-alone minutes, grandparents, and the years before a smartphone.</p>"
    },
    {
      "type": "text",
      "id": "proof_line",
      "label": "Proof line",
      "default": "42 years in business, American owned, Family Focused"
    },
    {
      "type": "text",
      "id": "price_callout",
      "label": "Price callout",
      "default": "$17.76/mo"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary CTA label",
      "default": "Order now"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "sound_label",
      "label": "Sound icon accessible label",
      "default": "Turn video sound on"
    }
  ],
  "presets": [
    {
      "name": "IP video hero"
    }
  ]
}
{% endschema %}
