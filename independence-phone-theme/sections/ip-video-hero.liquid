{% liquid
  assign hero_poster = 'ip-hero-video-poster.webp' | asset_url
  assign hero_poster_mobile = 'ip-hero-video-poster-mobile.webp' | asset_url
  if section.settings.poster_image != blank
    assign hero_poster = section.settings.poster_image | image_url: width: 2200
    assign hero_poster_mobile = hero_poster
  endif
%}

<section class="ip-hero full-width" data-hero-video>
  <div class="ip-hero__media">
    {% if section.settings.hero_video != blank %}
      {{
        section.settings.hero_video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'ip-hero__video'
      }}
    {% else %}
      <picture class="ip-hero__poster" aria-hidden="true">
        {% if section.settings.poster_image != blank %}
          {{
            section.settings.poster_image
            | image_url: width: 2200
            | image_tag: class: 'ip-hero__image', alt: '', loading: 'eager'
          }}
        {% else %}
          <source media="(max-width: 720px)" srcset="{{ 'ip-hero-video-poster-mobile.webp' | asset_url }}">
          <img
            class="ip-hero__image"
            src="{{ 'ip-hero-video-poster.webp' | asset_url }}"
            alt=""
            width="1280"
            height="720"
            loading="eager"
          >
        {% endif %}
      </picture>
      <video
        class="ip-hero__video is-source-switching"
        data-hero-video-player
        data-poster-desktop="{{ hero_poster }}"
        data-poster-mobile="{{ hero_poster_mobile }}"
        data-src-desktop="{{ 'ip-hero-video-desktop.mp4' | asset_url }}"
        data-src-mobile="{{ 'ip-hero-video.mp4' | asset_url }}"
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        poster="{{ hero_poster }}"
      >
        {% comment %}Mobile-safe fallback; JavaScript deterministically selects the correct viewport source.{% endcomment %}
        <source src="{{ 'ip-hero-video.mp4' | asset_url }}" type="video/mp4">
      </video>
    {% endif %}

    {% if section.settings.sound_label != blank %}
      <button
        class="ip-hero__sound"
        type="button"
        data-hero-sound-toggle
        data-label-idle="{{ section.settings.sound_label | escape }}"
        data-label-playing="Sound is on"
        data-label-muted="Sound is off. Play with sound"
        data-label-paused="Resume with sound"
        data-label-ended="Replay with sound"
        data-label-failed="Sound could not start. Try again"
        data-sound-state="muted"
        aria-label="Sound is off. {{ section.settings.sound_label | escape }}"
        aria-pressed="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M11 5 6.5 9H3v6h3.5l4.5 4V5Z"></path>
          <g class="ip-hero__sound-waves">
            <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
            <path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
          </g>
          <path class="ip-hero__sound-slash" d="M4 4 20 20"></path>
        </svg>
      </button>
    {% endif %}
  </div>

  <div class="ip-hero__inner">
    {% if section.settings.proof_line != blank %}
      <p class="ip-hero__proof">{{ section.settings.proof_line }}</p>
    {% endif %}

    <div class="ip-hero__copy">
      {% if section.settings.heading != blank %}
        <h1 class="ip-heading">
          {% if section.settings.heading == 'Give your child a phone, not the internet.' %}
            <span style="display: block; font-size: min(1em, 7vw); white-space: nowrap;">Give your child a phone,</span>
            <span style="display: block; font-size: min(1em, 7vw); white-space: nowrap;">Not the internet</span>
          {% else %}
            {{ section.settings.heading }}
          {% endif %}
        </h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="ip-lede">{{ section.settings.subheading }}</div>
      {% endif %}

      {% if section.settings.price_callout != blank %}
        <p class="ip-hero__price">{{ section.settings.price_callout }}</p>
      {% endif %}

      <div class="ip-buttons">
        {% if section.settings.primary_label != blank %}
          <a class="ip-button" href="{{ section.settings.primary_link | default: '/pages/order-now' }}">
            {{ section.settings.primary_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IP video hero",
  "settings": [
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero video"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Give your child a phone, not the internet."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Kids can call home without apps, browsers, social media, or a personal screen. Built for bus days, home-alone minutes, grandparents, and the years before a smartphone.</p>"
    },
    {
      "type": "text",
      "id": "proof_line",
      "label": "Proof line",
      "default": "Established in 1984."
    },
    {
      "type": "text",
      "id": "price_callout",
      "label": "Price callout",
      "default": "$17.76/mo"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary CTA label",
      "default": "Order now"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "sound_label",
      "label": "Sound icon accessible label",
      "default": "Play with sound"
    }
  ],
  "presets": [
    {
      "name": "IP video hero"
    }
  ]
}
{% endschema %}
