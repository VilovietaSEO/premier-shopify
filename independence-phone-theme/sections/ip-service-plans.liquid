<section class="ip-section ip-section--surface ip-service-plans{% if section.settings.compact_layout %} ip-service-plans--compact{% endif %}">
  <div class="ip-stack">
    {% if section.settings.eyebrow != blank %}
      <p class="ip-kicker">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="ip-heading ip-heading--medium ip-heading--wide">{{ section.settings.heading }}</h2>
    <div class="ip-lede">{{ section.settings.body }}</div>
  </div>

  <div class="ip-plan-grid ip-plan-grid--service">
    {% for block in section.blocks %}
      <article class="ip-card ip-plan-card" {{ block.shopify_attributes }}>
        <p class="ip-plan-card__label">{{ block.settings.label }}</p>
        <h3>{{ block.settings.title }}</h3>
        <p class="ip-price">{{ block.settings.price }}</p>
        <div>{{ block.settings.body }}</div>
      </article>
    {% endfor %}
  </div>

  {% if section.settings.disclosure != blank %}
    <div class="ip-disclosures">
      <p>{{ section.settings.disclosure }}</p>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "IP service plans",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Simple service"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Personal phone service, priced clearly."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Each phone pairs with a personal phone number and phone service. Choose the monthly plan or pay annually.</p>"
    },
    {
      "type": "textarea",
      "id": "disclosure",
      "label": "Disclosure",
      "default": "Shipping is one $15 charge per order in the USA. Applicable tax is calculated after the customer enters an address."
    },
    {
      "type": "checkbox",
      "id": "compact_layout",
      "label": "Use compact collection spacing",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Monthly"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Personal phone number + monthly service"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$17.76/mo"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Simple monthly phone service for the family phone.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IP service plans",
      "blocks": [
        {
          "type": "plan",
          "settings": {
            "label": "Monthly",
            "title": "Personal phone number + monthly service",
            "price": "$17.76/mo",
            "body": "<p>Simple monthly phone service for the family phone.</p>"
          }
        },
        {
          "type": "plan",
          "settings": {
            "label": "Annual",
            "title": "Personal phone number + annual service",
            "price": "$200/yr",
            "body": "<p>Annual service saves $13.12 compared with monthly billing.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
