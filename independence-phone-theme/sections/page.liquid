        {
          "@type": "Question",
          "name": "What is the difference between Classic Phone and Rugged Phone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both phones include Wi-Fi, Bluetooth, encrypted data transmission and storage, and 9-hour talk time. Rugged Phone also adds waterproof and drop-proof protection."
          }
