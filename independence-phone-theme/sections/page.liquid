{% comment %}
  Default page router.

  Shopify only exposes live-theme page templates in the page editor. This keeps
  the draft theme usable for launch QA when Order Now and FAQ pages are assigned
  to the default page template.
{% endcomment %}

{% if page.handle == 'order-now' %}
  {% liquid
    assign standard_product = all_products['standard-phone']
    assign rugged_product = all_products['rugged-phone']
    assign monthly_service_product = all_products['monthly-service']
    assign annual_service_product = all_products['annual-service']
    assign call_recording_product = all_products['call-recording']
    assign family_quiet_hours_product = all_products['family-quiet-hours']
    assign voicemail_to_email_product = all_products['voicemail-to-email']
    assign auto_attendant_product = all_products['auto-attendant']
    assign addon_bundle_product = all_products['add-on-bundle']
    assign order_builder_id = section.id | append: '-page-order'
  %}
  {% capture order_builder_body %}<p>Choose your phone, service plan, and add-ons below.</p>{% endcapture %}

  {% render 'ip-order-builder-form',
    builder_id: order_builder_id,
    standard_product: standard_product,
    rugged_product: rugged_product,
    monthly_service_product: monthly_service_product,
    annual_service_product: annual_service_product,
    call_recording_product: call_recording_product,
    family_quiet_hours_product: family_quiet_hours_product,
    voicemail_to_email_product: voicemail_to_email_product,
    auto_attendant_product: auto_attendant_product,
    addon_bundle_product: addon_bundle_product,
    heading: 'Build your Independence Phone order now.',
    body: order_builder_body,
    checkout_note: 'Taxes, shipping, and recurring billing will be shown in the cart.',
    button_label: 'Add order to cart'
  %}
{% elsif page.handle == 'faq' %}
  <section class="ip-section ip-section--surface ip-faq-section full-width">
    <div class="ip-stack">
      <h1 class="ip-heading ip-heading--medium ip-heading--wide">Install, use, refer, and troubleshoot Independence Phone.</h1>
      <div class="ip-lede">
        <p>Use this page as the support path for setup, service questions, referrals, and common troubleshooting.</p>
      </div>
    </div>

    <div class="ip-faq ip-faq--page-router">
      <details open>
        <summary>How do I install the phone?</summary>
        <div class="ip-faq__answer">
          <p>Plug in the charging base, connect the cordless Wi-Fi handset to the home Wi-Fi network, and follow the setup instructions provided with the service activation.</p>
        </div>
      </details>
      <details>
        <summary>How does my family use it?</summary>
        <div class="ip-faq__answer">
          <p>The phone is designed around calling. It does not include apps, a web browser, social feeds, GPS, camera, or cellular mobility unless the product scope changes.</p>
        </div>
      </details>
      <details id="referral-offer">
        <summary>How does the referral offer work?</summary>
        <div class="ip-faq__answer">
          <p>If a friend referred you, upon checkout type in their referral code, and you both will get one month of service for free!</p>
        </div>
      </details>
      <details>
        <summary>Where do I go for troubleshooting?</summary>
        <div class="ip-faq__answer">
          <p>Use the contact page for setup, service, billing, or phone troubleshooting. The team can expand this page with step-by-step support articles after launch.</p>
        </div>
      </details>
      <details>
        <summary>Does it have internet?</summary>
        <div class="ip-faq__answer">
          <p>No. Independence Phone is positioned as a phone-first product without web browsing, apps, or social feeds.</p>
        </div>
      </details>
      <details>
        <summary>What is the monthly fee?</summary>
        <div class="ip-faq__answer">
          <p>Personal phone number plus monthly phone service is $17.76/mo. Annual service is $200/yr and saves $13.12 compared with monthly billing.</p>
        </div>
      </details>
      <details id="phone-comparison">
        <summary>What is the difference between Classic Phone and Rugged Phone?</summary>
        <div class="ip-faq__answer">
          <p>Both phones include Wi-Fi, Bluetooth, encrypted data transmission and storage, and 9-hour talk time. Rugged Phone also adds waterproof and drop-proof protection.</p>
        </div>
      </details>
    </div>
  </section>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I install the phone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plug in the charging base, connect the cordless Wi-Fi handset to the home Wi-Fi network, and follow the setup instructions provided with the service activation."
