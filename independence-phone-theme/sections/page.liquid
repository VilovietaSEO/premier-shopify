{% else %}
  <section class="ip-section ip-page-content">
    <div class="ip-page-content__inner">
      <h1 class="ip-heading ip-heading--medium">{{ page.title }}</h1>
      <div class="ip-page-content__body">
        {{ page.content }}
      </div>
    </div>
  </section>
{% endif %}

