<section class="ip-section ip-section--ink ip-section--flag full-width">
  <div class="ip-trust">
    <div class="ip-stack">
      {% if section.settings.eyebrow != blank %}
        <p class="ip-kicker">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="ip-heading ip-heading--medium ip-heading--wide">{{ section.settings.heading }}</h2>
      <div class="ip-lede">{{ section.settings.body }}</div>
    </div>

    <div class="ip-trust__items">
      {% for block in section.blocks %}
        <article class="ip-trust__item" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.body }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IP trust band",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "American-owned. Family-focused."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A practical phone choice backed by decades of communication experience."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>The patriotic layer should support trust after parents understand the product: a phone that helps families stay connected without rushing into smartphone life.</p>"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "American-owned"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Use as a trust signal, not the whole sales argument."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IP trust band",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "title": "American-owned",
            "body": "A values-aligned trust layer for families choosing a simpler first phone."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "title": "42 years in communications",
            "body": "Use the company history to make the product feel dependable and experienced."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "title": "Patriot Package",
            "body": "A concrete introductory offer, not just patriotic styling."
          }
        }
      ]
    }
  ]
}
{% endschema %}
