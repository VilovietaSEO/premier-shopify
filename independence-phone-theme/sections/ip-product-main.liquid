{% liquid
  assign is_patriot = false
  if product.handle == 'patriot-phone'
    assign is_patriot = true
  endif

  if is_patriot
    assign fallback_title = 'Patriot Phone'
    assign fallback_price = '$149'
    assign fallback_deck = 'The rugged family phone for busier homes, tougher handling, and longer days.'
    assign fallback_best_for = 'Best for families who want rugged durability, longer battery life, and a more resilient handset.'
    assign fallback_image = 'ip-current-site-product-2.png'
    assign fallback_gallery_image = 'ip-current-site-product-1.png'
  else
    assign fallback_title = 'Freedom Phone'
    assign fallback_price = '$99'
    assign fallback_deck = 'The everyday family phone for kids who need to call home without stepping into smartphone life.'
    assign fallback_best_for = 'Best for home, grandparents, short independence windows, and everyday family calling.'
    assign fallback_image = 'ip-current-site-product-1.png'
    assign fallback_gallery_image = 'ip-current-site-product-3.png'
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign product_deck = product.metafields.custom.product_deck.value
  assign best_for = product.metafields.custom.best_for.value | default: fallback_best_for
  assign custom_specs = product.metafields.custom.specs.value | strip
  assign custom_specs_list = custom_specs | split: ';'
  assign service_option_count = 0
  assign addon_option_count = 0
  assign default_service_index = 0

  for block in section.blocks
    if block.type == 'service_plan'
      assign service_option_count = service_option_count | plus: 1
      if default_service_index == 0
        assign default_service_index = service_option_count
      endif
      if block.settings.default_selected
        assign default_service_index = service_option_count
      endif
    elsif block.type == 'addon_option'
      assign addon_option_count = addon_option_count | plus: 1
    endif
  endfor
%}

<section class="ip-product-main">
  <div class="ip-product-main__gallery" data-product-gallery>
    <div class="ip-product-main__media" aria-live="polite">
      {% if product.media.size > 0 %}
        {% for media in product.media %}
          {% assign media_alt = media.alt | default: product.title | default: fallback_title %}
          <figure
            class="ip-product-main__slide{% if forloop.first %} is-active{% endif %}"
            data-gallery-slide="{{ forloop.index0 }}"
            {% unless forloop.first %}
              hidden
            {% endunless %}
          >
            {% case media.media_type %}
              {% when 'image' %}
                {{
                  media
                  | image_url: width: 1400
                  | image_tag:
                    alt: media_alt,
                    loading: 'eager',
                    fetchpriority: 'high',
                    sizes: '(min-width: 990px) 54vw, 100vw'
                }}
              {% when 'video' %}
                {{ media | video_tag: controls: true, image_size: '1400x', class: 'ip-product-main__video' }}
              {% when 'external_video' %}
                {{ media | external_video_tag: class: 'ip-product-main__external-video' }}
              {% else %}
                {% if media.preview_image %}
                  {{
                    media.preview_image
                    | image_url: width: 1400
                    | image_tag:
                      alt: media_alt,
                      loading: 'eager',
                      fetchpriority: 'high',
                      sizes: '(min-width: 990px) 54vw, 100vw'
                  }}
                {% endif %}
            {% endcase %}
          </figure>
        {% endfor %}
      {% else %}
        <figure class="ip-product-main__slide is-active" data-gallery-slide="0">
          <img
            src="{{ fallback_image | asset_url }}"
            alt="{{ fallback_title }}"
            width="1200"
            height="1200"
            loading="eager"
            fetchpriority="high"
          >
        </figure>
        <figure class="ip-product-main__slide" data-gallery-slide="1" hidden>
          <img
            src="{{ fallback_gallery_image | asset_url }}"
            alt="{{ fallback_title }} alternate product image"
            width="1200"
            height="1200"
            loading="lazy"
          >
        </figure>
      {% endif %}
    </div>

    {% if product.media.size > 1 %}
      <div class="ip-product-main__thumbs" aria-label="{{ product.title | default: fallback_title }} media">
        {% for media in product.media %}
          <button
            class="ip-product-main__thumb{% if forloop.first %} is-active{% endif %}"
            type="button"
            data-gallery-thumb="{{ forloop.index0 }}"
            aria-label="Show {{ product.title | default: fallback_title }} media {{ forloop.index }}"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            {% if media.preview_image %}
              {{
                media.preview_image
                | image_url: width: 220
                | image_tag:
                  alt: '',
                  loading: 'lazy'
              }}
            {% else %}
              <span>{{ media.media_type | replace: '_', ' ' }}</span>
            {% endif %}
          </button>
        {% endfor %}
      </div>
    {% elsif product.media.size == 0 %}
      <div class="ip-product-main__thumbs" aria-label="{{ fallback_title }} media">
        <button
          class="ip-product-main__thumb is-active"
          type="button"
          data-gallery-thumb="0"
          aria-label="Show {{ fallback_title }} media 1"
          aria-pressed="true"
        >
          <img src="{{ fallback_image | asset_url }}" alt="" width="220" height="220" loading="lazy">
        </button>
        <button
          class="ip-product-main__thumb"
          type="button"
          data-gallery-thumb="1"
          aria-label="Show {{ fallback_title }} media 2"
          aria-pressed="false"
        >
          <img src="{{ fallback_gallery_image | asset_url }}" alt="" width="220" height="220" loading="lazy">
        </button>
      </div>
    {% endif %}
  </div>

  <div class="ip-stack">
    <p class="ip-kicker">{{ section.settings.eyebrow }}</p>
    <h1 class="ip-heading ip-heading--medium">{{ product.title | default: fallback_title }}</h1>
    <p class="ip-lede">
      {% if product_deck != blank %}
        {{ product_deck }}
      {% elsif product.description != blank %}
        {{ product.description | strip_html }}
      {% else %}
        {{ fallback_deck }}
      {% endif %}
    </p>

    <p class="ip-price">
      {% if product.price %}
        {{ product.price | money }}
      {% else %}
        {{ fallback_price }}
      {% endif %}
    </p>

    <div class="ip-card" style="padding: 1rem;">
      <h2 class="ip-story-card__title">Best for</h2>
      <p>{{ best_for }}</p>
    </div>

    <ul class="ip-spec-list">
      {% if custom_specs != blank %}
        {% for spec in custom_specs_list %}
          {% assign spec_text = spec | strip %}
          {% if spec_text != blank %}
            <li>{{ spec_text }}</li>
          {% endif %}
        {% endfor %}
      {% elsif is_patriot %}
        <li>Rugged cordless Wi-Fi handset with charging base</li>
        <li>Waterproof and dust-proof, drop-proof up to 1.8 meters</li>
        <li>Non-slip, anti-scratch, anti-bacterial construction</li>
        <li>HD Voice, AI Noise Cancellation, and Acoustic Shield</li>
        <li>Encrypted data transmission and storage</li>
        <li>Built-in Bluetooth 5.0</li>
        <li>13-hour talk time, 300-hour standby battery</li>
      {% else %}
        <li>Heavy-duty cordless Wi-Fi handset with charging base</li>
        <li>HD audio quality</li>
        <li>Smart noise filtering</li>
        <li>Encrypted data transmission and storage</li>
        <li>Built-in Bluetooth 5.0</li>
        <li>9-hour talk time, 200-hour standby battery</li>
      {% endif %}
    </ul>

    {% if product != blank %}
      {% form 'product', product, class: 'ip-product-form' %}
        {% if product.has_only_default_variant %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% else %}
          <label for="ProductVariant-{{ section.id }}">Choose an option</label>
          <select id="ProductVariant-{{ section.id }}" name="id">
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant == current_variant %}
                  selected="selected"
                {% endif %}
              >
                {{ variant.title }} - {{ variant.price | money }}
              </option>
            {% endfor %}
          </select>
        {% endif %}

        <label for="Quantity-{{ section.id }}">Quantity</label>
        <input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1">

        {% if service_option_count > 0 or addon_option_count > 0 %}
          <div class="ip-product-options">
            {% if section.settings.purchase_options_heading != blank %}
              <h2>{{ section.settings.purchase_options_heading }}</h2>
            {% endif %}

            {% if service_option_count > 0 %}
              <fieldset class="ip-choice-group">
                <legend>{{ section.settings.service_options_heading }}</legend>
                {% assign service_option_index = 0 %}
                {% for block in section.blocks %}
                  {% if block.type == 'service_plan' %}
                    {% assign service_option_index = service_option_index | plus: 1 %}
                    {% assign service_value = block.settings.title | append: ' - ' | append: block.settings.price %}
                    {% assign service_input_id = 'ServiceOption-' | append: section.id | append: '-' | append: service_option_index %}
                    <label class="ip-choice" for="{{ service_input_id }}" {{ block.shopify_attributes }}>
                      <input
                        id="{{ service_input_id }}"
                        type="radio"
                        name="properties[Service plan]"
                        value="{{ service_value | escape }}"
                        {% if service_option_index == default_service_index %}
                          checked
                        {% endif %}
                      >
                      <span>
                        <strong>{{ block.settings.title }}</strong>
                        <small>{{ block.settings.price }}</small>
                      </span>
                    </label>
                  {% endif %}
                {% endfor %}
              </fieldset>
            {% endif %}

            {% if addon_option_count > 0 %}
              <fieldset class="ip-choice-group">
                <legend>{{ section.settings.addon_options_heading }}</legend>
                {% assign addon_option_index = 0 %}
                {% for block in section.blocks %}
                  {% if block.type == 'addon_option' %}
                    {% assign addon_option_index = addon_option_index | plus: 1 %}
                    {% assign addon_input_id = 'AddonOption-' | append: section.id | append: '-' | append: addon_option_index %}
                    <label class="ip-choice" for="{{ addon_input_id }}" {{ block.shopify_attributes }}>
                      <input
                        id="{{ addon_input_id }}"
                        type="checkbox"
                        name="properties[{{ block.settings.title | escape }}]"
                        value="{{ block.settings.price | escape }}"
                      >
                      <span>
                        <strong>{{ block.settings.title }}</strong>
                        <small>{{ block.settings.price }}</small>
                      </span>
                    </label>
                  {% endif %}
                {% endfor %}
              </fieldset>
            {% endif %}

            {% if section.settings.purchase_options_note != blank %}
              <p class="ip-form-note">{{ section.settings.purchase_options_note }}</p>
            {% endif %}
          </div>
        {% endif %}

        <button type="submit" {% unless current_variant.available %}disabled{% endunless %}>
          {% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}
        </button>

        {% if section.settings.show_dynamic_checkout %}
          {{ form | payment_button }}
        {% endif %}
      {% endform %}
    {% endif %}

    <div class="ip-disclosures">
      <p>Service: personal phone number + monthly service is $17.76/mo. Annual service is $200/yr and saves $13.12.</p>
      <p>Shipping: $15 per phone anywhere in the USA.</p>
      <p>All products and services are subject to federal, state, and local taxes.</p>
      <p>Both products can present Call Recording, Time Conditions, Voicemail to Email, Victory Bundle, and Auto Attendant add-ons.</p>
    </div>
  </div>
</section>

<script>
  (() => {
    if (window.__ipProductGalleryReady) return;
    window.__ipProductGalleryReady = true;

    const setActive = (gallery, nextIndex) => {
      const slides = [...gallery.querySelectorAll('[data-gallery-slide]')];
      const thumbs = [...gallery.querySelectorAll('[data-gallery-thumb]')];
      if (!slides.length) return;

      const safeIndex = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        const active = index === safeIndex;
        slide.hidden = !active;
        slide.classList.toggle('is-active', active);
      });
      thumbs.forEach((thumb, index) => {
        const active = index === safeIndex;
        thumb.classList.toggle('is-active', active);
        thumb.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    };

    document.addEventListener('click', (event) => {
      const thumb = event.target.closest('[data-gallery-thumb]');
      if (!thumb) return;

      const gallery = thumb.closest('[data-product-gallery]');
      if (!gallery) return;

      setActive(gallery, Number(thumb.dataset.galleryThumb || 0));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;

      const gallery = event.target.closest('[data-product-gallery]');
      if (!gallery) return;

      const thumbs = [...gallery.querySelectorAll('[data-gallery-thumb]')];
      if (!thumbs.length) return;

      const current = thumbs.findIndex((thumb) => thumb.classList.contains('is-active'));
      const delta = event.key === 'ArrowRight' ? 1 : -1;
      const next = (current + delta + thumbs.length) % thumbs.length;
      event.preventDefault();
      setActive(gallery, next);
      thumbs[next].focus();
    });
  })();
</script>

{% schema %}
{
  "name": "IP product main",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A phone that acts like a phone"
    },
    {
      "type": "text",
      "id": "purchase_options_heading",
      "label": "Purchase options heading",
      "default": "Choose service and add-ons"
    },
    {
      "type": "text",
      "id": "service_options_heading",
      "label": "Service options heading",
      "default": "Service plan"
    },
    {
      "type": "text",
      "id": "addon_options_heading",
      "label": "Add-on options heading",
      "default": "Optional add-ons"
    },
    {
      "type": "textarea",
      "id": "purchase_options_note",
      "label": "Purchase options note",
      "default": "Service and add-on selections are captured with the order so setup and recurring billing can be confirmed after checkout."
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout buttons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "service_plan",
      "name": "Service plan option",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Monthly service"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$17.76/mo"
        },
        {
          "type": "checkbox",
          "id": "default_selected",
          "label": "Selected by default",
          "default": false
        }
      ]
    },
    {
      "type": "addon_option",
      "name": "Add-on option",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Call Recording"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$5/mo"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
