<section class="ip-section ip-section--surface ip-faq-section full-width">
  <div class="ip-stack">
    {% if section.settings.eyebrow != blank %}
      <p class="ip-kicker">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="ip-heading ip-heading--medium ip-heading--wide">{{ section.settings.heading }}</h2>
    {% if section.settings.body != blank %}
      <div class="ip-lede">{{ section.settings.body }}</div>
    {% endif %}
  </div>

  {% if section.settings.static_list %}
    <div class="ip-faq ip-faq--static" style="margin-top: 2rem;">
      {% for block in section.blocks %}
        {% assign faq_anchor = block.settings.anchor_id | strip | handleize %}
        <article class="ip-faq__item"{% if faq_anchor != blank %} id="{{ faq_anchor }}"{% endif %} {{ block.shopify_attributes }}>
          <h3 class="ip-faq__question">{{ block.settings.question }}</h3>
          <div class="ip-faq__answer">{{ block.settings.answer }}</div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="ip-faq" style="margin-top: 2rem;">
      {% for block in section.blocks %}
        {% assign faq_anchor = block.settings.anchor_id | strip | handleize %}
        <details{% if faq_anchor != blank %} id="{{ faq_anchor }}"{% endif %} {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="ip-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% if section.blocks.size > 0 %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for block in section.blocks %}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "IP FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions parents ask when choosing INDEPENDENCE PHONE."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first FAQ by default",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "static_list",
      "label": "Show all answers without accordion controls",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ row",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Does it have internet?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>INDEPENDENCE PHONE is positioned as a phone-first product without web browsing, apps, or social feeds.</p>"
        },
        {
          "type": "text",
          "id": "anchor_id",
          "label": "Link anchor (optional)",
          "info": "Use a short value such as phone-comparison when another page should link directly to this answer."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IP FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Does it have internet?",
            "answer": "<p>INDEPENDENCE PHONE is positioned as a phone-first product without web browsing, apps, or social feeds.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Does it have an app store or social media?",
            "answer": "<p>No. The storefront copy should keep the promise simple: calling without the app-store and social-feed ecosystem.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What is the monthly fee?",
            "answer": "<p>Personal phone number plus monthly phone service is $17.76/mo. Annual service is $200/yr and saves $13.12 compared with monthly billing.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What is the difference between Classic Phone and Rugged Phone?",
            "answer": "<p>Both phones include Wi-Fi, Bluetooth, encrypted data transmission and storage, and 9-hour talk time. Rugged Phone also adds waterproof and drop-proof protection.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How does the referral offer work?",
            "answer": "<p>If a friend referred you, upon checkout type in their referral code, and you both will get one month of service for free!</p>",
            "anchor_id": "referral-offer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
