<section class="ip-section ip-section--ink ip-section--flag full-width">
  <div class="ip-package">
    <div class="ip-stack">
      {% if section.settings.eyebrow != blank %}
        <p class="ip-kicker">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="ip-heading ip-heading--medium ip-heading--wide">{{ section.settings.heading }}</h2>
      <div class="ip-lede">{{ section.settings.body }}</div>
      <div class="ip-buttons">
        {% if section.settings.cta_label != blank %}
          <a class="ip-button" href="{{ section.settings.cta_link | default: '/pages/order-now' }}">
            {{ section.settings.cta_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ip-package__price">
      <p class="ip-kicker">{{ section.settings.price_label }}</p>
      <strong>{{ section.settings.price }}</strong>
      <p>{{ section.settings.includes }}</p>
      <p class="ip-note">{{ section.settings.disclosure }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IP package band",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Annual service"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Simple annual INDEPENDENCE PHONE service."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Choose annual phone service and save compared with twelve monthly payments.</p>"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Price label",
      "default": "Annual service"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$200/yr"
    },
    {
      "type": "textarea",
      "id": "includes",
      "label": "Includes",
      "default": "Personal phone number and one year of service"
    },
    {
      "type": "textarea",
      "id": "disclosure",
      "label": "Disclosure",
      "default": "Savings shown before checkout. Taxes may apply."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Order now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "presets": [
    {
      "name": "IP package band"
    }
  ]
}
{% endschema %}
