{% if section.settings.enabled %}
  <section class="ip-announcement full-width" aria-label="Store announcement">
    <div class="ip-announcement__inner">
      {% if section.settings.text != blank %}
        {% if section.settings.link != blank %}
          <a href="{{ section.settings.link }}">{{ section.settings.text | newline_to_br }}</a>
        {% else %}
          <p>{{ section.settings.text | newline_to_br }}</p>
        {% endif %}
      {% endif %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "IP announcement banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show announcement banner",
      "default": true
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Banner text",
      "default": "Take advantage of our limited offer honoring the 250th anniversary of America\nPatriot Package Includes: Classic Phone, 1 Year phone service, all 4 add on's for only $250! a savings of $303.12"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    }
  ],
  "presets": [
    {
      "name": "IP announcement banner"
    }
  ]
}
{% endschema %}
