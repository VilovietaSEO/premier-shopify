<section class="ip-section ip-stack ip-billing-item">
  <p class="ip-kicker">{{ section.settings.eyebrow }}</p>
  <h1 class="ip-heading ip-heading--medium">{{ product.title }}</h1>
  <div class="ip-lede">
    {{ section.settings.body }}
  </div>
  <a class="ip-button" href="/pages/order-now">{{ section.settings.button_label }}</a>
</section>

{% schema %}
{
  "name": "IP billing item",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Setup billing item"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>This item is part of an Independence Phone setup and is only available through the guided order flow.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Build a phone setup"
    }
  ]
}
{% endschema %}
