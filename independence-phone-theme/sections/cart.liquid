{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<section class="ip-cart">
  <div class="ip-stack ip-cart__header">
    <h1 class="ip-heading ip-heading--medium">Your INDEPENDENCE PHONE Cart</h1>
    <p class="ip-note">Review your phone, service choices, and add-ons before checkout.</p>
  </div>

  {% if cart.item_count == 0 %}
    <div class="ip-card ip-cart__empty">
      <p>Your cart is empty.</p>
      <a class="ip-button" href="{{ routes.root_url }}pages/order-now">Order now</a>
    </div>
  {% else %}
    {% assign cart_has_orphan_child = false %}
    {% assign cart_has_incomplete_order = false %}
    {% assign cart_future_charge = 0 %}
    {% for future_item in cart.items %}
      {% assign future_unit_charge = 0 %}
      {% for future_property in future_item.properties %}
        {% if future_property.first == '_setup_future_charge_cents' %}
          {% assign future_unit_charge = future_property.last | plus: 0 %}
        {% endif %}
      {% endfor %}
      {% assign future_line_charge = future_unit_charge | times: future_item.quantity %}
      {% assign cart_future_charge = cart_future_charge | plus: future_line_charge %}
    {% endfor %}
    {% assign flat_shipping = 1500 %}
    {% assign due_today_before_tax = cart.total_price | plus: flat_shipping %}
    <form
      action="{{ routes.cart_url }}"
      method="post"
      class="ip-cart__form"
      data-cart-form
      data-revio-checkout-url="{{ section.settings.revio_checkout_url | escape }}"
    >
      <div class="ip-cart__items">
        {% for item in cart.items %}
          {% assign cart_line_index = forloop.index %}
          {% assign service_plan_value = '' %}
          {% assign setup_id = '' %}
          {% assign setup_parent = false %}
          {% assign setup_role = '' %}
          {% for property in item.properties %}
            {% if property.first == 'Service plan' and property.last != blank %}
              {% assign service_plan_value = property.last %}
            {% elsif property.first == '_setup_id' and property.last != blank %}
              {% assign setup_id = property.last %}
            {% elsif property.first == '_setup_parent' and property.last == 'true' %}
              {% assign setup_parent = true %}
            {% elsif property.first == '_setup_role' and property.last != blank %}
              {% assign setup_role = property.last %}
            {% endif %}
          {% endfor %}

          {% assign orphan_setup_child = false %}
          {% if setup_parent %}
            {% assign setup_parent_exists = false %}
            {% if setup_id != blank %}
              {% for possible_parent in cart.items %}
                {% assign possible_parent_setup_id = '' %}
                {% assign possible_parent_is_child = false %}
                {% for possible_parent_property in possible_parent.properties %}
                  {% if possible_parent_property.first == '_setup_id' %}
                    {% assign possible_parent_setup_id = possible_parent_property.last %}
                  {% elsif possible_parent_property.first == '_setup_parent' and possible_parent_property.last == 'true' %}
                    {% assign possible_parent_is_child = true %}
                  {% endif %}
                {% endfor %}
                {% if possible_parent_is_child == false and possible_parent_setup_id == setup_id %}
                  {% assign setup_parent_exists = true %}
                  {% break %}
                {% endif %}
              {% endfor %}
            {% endif %}
            {% unless setup_parent_exists %}
              {% assign orphan_setup_child = true %}
              {% assign cart_has_orphan_child = true %}
              {% assign setup_parent = false %}
              {% assign setup_id = '' %}
            {% endunless %}
          {% endif %}

          {% unless setup_parent %}
            {% assign setup_child_count = 0 %}
            {% assign setup_has_service = false %}
            {% if setup_id != blank %}
              {% for child in cart.items %}
                {% assign child_setup_id = '' %}
                {% assign child_is_setup_child = false %}
                {% assign child_setup_role = '' %}
                {% for child_property in child.properties %}
                  {% if child_property.first == '_setup_id' %}
                    {% assign child_setup_id = child_property.last %}
                  {% elsif child_property.first == '_setup_parent' and child_property.last == 'true' %}
                    {% assign child_is_setup_child = true %}
                  {% elsif child_property.first == '_setup_role' %}
                    {% assign child_setup_role = child_property.last %}
                  {% endif %}
                {% endfor %}
                {% if child_is_setup_child and child_setup_id == setup_id %}
                  {% assign setup_child_count = setup_child_count | plus: 1 %}
                  {% if child_setup_role == 'service' %}
                    {% assign setup_has_service = true %}
                  {% endif %}
                {% endif %}
              {% endfor %}
              {% unless setup_has_service %}
                {% assign cart_has_incomplete_order = true %}
              {% endunless %}
            {% endif %}

            {% assign visible_property_count = 0 %}
            {% capture cart_savings_source %}
              {% for property in item.properties %}
                {% assign savings_property_name = property.first %}
                {% assign savings_property_value = property.last %}
                {% assign savings_first_character = savings_property_name | slice: 0 %}
                {% if savings_property_value != blank and savings_first_character != '_' %}
                  {{ savings_property_name }} {{ savings_property_value }}
                {% endif %}
              {% endfor %}
              {% if setup_id != blank %}
                {% for savings_child in cart.items %}
                  {% assign savings_child_setup_id = '' %}
                  {% assign savings_child_is_child = false %}
                  {% for savings_child_property in savings_child.properties %}
                    {% if savings_child_property.first == '_setup_id' %}
                      {% assign savings_child_setup_id = savings_child_property.last %}
                    {% elsif savings_child_property.first == '_setup_parent' and savings_child_property.last == 'true' %}
                      {% assign savings_child_is_child = true %}
                    {% endif %}
                  {% endfor %}
                  {% if savings_child_is_child and savings_child_setup_id == setup_id %}
                    {% for savings_child_property in savings_child.properties %}
                      {% assign savings_child_name = savings_child_property.first %}
                      {% assign savings_child_value = savings_child_property.last %}
                      {% assign savings_child_first_character = savings_child_name | slice: 0 %}
                      {% if savings_child_value != blank and savings_child_first_character != '_' %}
                        {{ savings_child_name }} {{ savings_child_value }}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                {% endfor %}
              {% endif %}
            {% endcapture %}
            {% for property in item.properties %}
              {% assign property_name = property.first %}
              {% assign property_value = property.last %}
              {% assign first_character = property_name | slice: 0 %}
              {% assign show_property = true %}
              {% if property_value == blank or first_character == '_' or property_name == 'Policy agreement' %}
                {% assign show_property = false %}
              {% endif %}
              {% if setup_id != blank and property_name != 'Requested area code' and property_name != 'Discount/referral code' and property_name != 'Referral' %}
                {% assign show_property = false %}
              {% endif %}
              {% if show_property %}
                {% assign visible_property_count = visible_property_count | plus: 1 %}
              {% endif %}
            {% endfor %}

            {% assign approved_phone_asset = '' %}
            {% if item.product.handle == 'standard-phone' %}
              {% assign approved_phone_asset = 'ip-classic-phone-front.webp' %}
            {% elsif item.product.handle == 'rugged-phone' %}
              {% assign approved_phone_asset = 'ip-rugged-phone-front.webp' %}
            {% endif %}
            <article
              class="ip-card ip-cart-item{% if approved_phone_asset == blank and item.image == blank %} ip-cart-item--no-media{% endif %}"
              data-cart-line-item
              {% if setup_id != blank %}data-cart-setup{% endif %}
              {% if setup_id != blank and setup_has_service == false %}data-cart-incomplete-setup{% endif %}
              {% if orphan_setup_child %}data-cart-orphan-child{% endif %}
              data-cart-key="{{ item.key }}"
              data-setup-id="{{ setup_id | escape }}"
              data-setup-parent="false"
              data-setup-role="{{ setup_role | escape }}"
              data-cart-savings-source="{{ cart_savings_source | strip | escape }}"
            >
              {% if approved_phone_asset != blank %}
                <div class="ip-cart-item__media">
                  <a href="{{ item.url }}">
                    <img
                      src="{{ approved_phone_asset | asset_url }}"
                      alt="Front view of the {{ item.product.title | escape }}"
                      width="1600"
                      height="1280"
                      loading="eager"
                    >
                  </a>
                </div>
              {% elsif item.image %}
                <div class="ip-cart-item__media">
                  {% render 'image', image: item.image, url: item.url, width: 360 %}
                </div>
              {% endif %}

              <div class="ip-cart-item__heading">
                <div>
                  <h2>{{ item.product.title }}</h2>
                  {% unless item.product.has_only_default_variant %}
                    <p class="ip-note">{{ item.variant.title }}</p>
                  {% endunless %}
                </div>
                <p class="ip-price" data-cart-line-price="{{ forloop.index }}">{{ item.final_line_price | money }}</p>
              </div>

              <div class="ip-cart-item__body">
                {% if orphan_setup_child %}
                  <p class="ip-form-note ip-form-note--error">
                    This billing item is no longer attached to a phone. Remove it before checkout, then rebuild the order if needed.
                  </p>
                {% endif %}
                {% if setup_id != blank and setup_has_service == false %}
                  <p class="ip-form-note ip-form-note--error">
                    This phone is missing its required service selection. Remove it and rebuild the order before checkout.
                  </p>
                {% endif %}

                {% if visible_property_count > 0 %}
                  <dl class="ip-cart-properties" aria-label="Setup details" data-cart-properties>
                    {% for property in item.properties %}
                      {% assign property_name = property.first %}
                      {% assign property_value = property.last %}
                      {% assign first_character = property_name | slice: 0 %}
                      {% assign show_property = true %}
                      {% if property_value == blank or first_character == '_' or property_name == 'Policy agreement' %}
                        {% assign show_property = false %}
                      {% endif %}
                      {% if setup_id != blank and property_name != 'Requested area code' and property_name != 'Discount/referral code' and property_name != 'Referral' %}
                        {% assign show_property = false %}
                      {% endif %}
                      {% if show_property %}
                        <div>
                          <dt>{{ property_name }}</dt>
                          <dd>
                            {% if property_value contains '/uploads/' %}
                              <a href="{{ property_value }}">Uploaded file</a>
                            {% else %}
                              {{ property_value }}
                            {% endif %}
                          </dd>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </dl>
                {% endif %}

                {% if setup_child_count > 0 %}
                  <dl class="ip-cart-setup-lines" aria-label="Selected service and add-ons" data-cart-setup-children>
                    {% assign setup_role_order = 'service,addon_bundle,addon' | split: ',' %}
                    {% for desired_setup_role in setup_role_order %}
                      {% for child in cart.items %}
                        {% assign child_setup_id = '' %}
                        {% assign child_is_setup_child = false %}
                        {% assign child_setup_role = '' %}
                        {% assign child_billing_value = '' %}
                        {% for child_property in child.properties %}
                          {% if child_property.first == '_setup_id' %}
                            {% assign child_setup_id = child_property.last %}
                          {% elsif child_property.first == '_setup_parent' and child_property.last == 'true' %}
                            {% assign child_is_setup_child = true %}
                          {% elsif child_property.first == '_setup_role' %}
                            {% assign child_setup_role = child_property.last %}
                          {% elsif child_property.first == '_setup_billing_value' %}
                            {% assign child_billing_value = child_property.last %}
                          {% endif %}
                        {% endfor %}
                        {% if child_is_setup_child and child_setup_id == setup_id and child_setup_role == desired_setup_role %}
                          <div
                            class="ip-cart-setup-line"
                            data-cart-line-item
                            data-cart-setup-child
                            data-cart-key="{{ child.key }}"
                            data-setup-id="{{ setup_id | escape }}"
                            data-setup-parent="true"
                            data-setup-role="{{ child_setup_role | escape }}"
                          >
                            <dt>
                              <strong>{{ child.product.title }}</strong>
                              {% if child_billing_value != blank %}<small>{{ child_billing_value }}</small>{% endif %}
                            </dt>
                            <dd>
                              <span>Billed on the 1st of the next month</span>
                              {% if child_setup_role == 'addon' or child_setup_role == 'addon_bundle' %}
                                <button
                                  class="ip-cart-setup-line__remove"
                                  type="button"
                                  data-cart-child-remove
                                  aria-label="Remove {{ child.product.title | escape }}"
                                >
                                  {{ 'cart.remove' | t }}
                                </button>
                              {% endif %}
                            </dd>
                            <input
                              type="hidden"
                              name="updates[{{ child.key }}]"
                              value="{{ child.quantity }}"
                              data-cart-child-quantity
                            >
                          </div>
                        {% endif %}
                      {% endfor %}
                    {% endfor %}
                  </dl>
                {% endif %}

                {% assign addon_blocks = section.blocks | where: 'type', 'addon_option' %}
                {% if addon_blocks.size > 0 and setup_id == blank and orphan_setup_child == false %}
                  <div
                    class="ip-cart-addons"
                    data-cart-addon-selector
                    data-cart-line="{{ forloop.index }}"
                    data-service-name="Service plan"
                    data-service-value="{{ service_plan_value | escape }}"
                  >
                    <h3>{{ section.settings.addon_options_heading }}</h3>
                    <div class="ip-cart-addons__grid">
                      {% for block in addon_blocks %}
                        {% assign addon_selected = false %}
                        {% assign billing_variant = block.settings.billing_product.selected_or_first_available_variant %}
                        {% for property in item.properties %}
                          {% if property.first == block.settings.title and property.last != blank %}
                            {% assign addon_selected = true %}
                          {% endif %}
                        {% endfor %}
                        {% assign addon_input_id = 'CartAddon-' | append: cart_line_index | append: '-' | append: forloop.index %}
                        <label class="ip-choice" for="{{ addon_input_id }}" {{ block.shopify_attributes }}>
                          <input
                            id="{{ addon_input_id }}"
                            type="checkbox"
                            data-cart-addon-option
                            data-property-name="{{ block.settings.title | escape }}"
                            data-property-value="{{ block.settings.price | escape }}"
                            data-billing-variant="{{ billing_variant.id }}"
                            data-billing-role="addon"
                            {% if addon_selected %}checked{% endif %}
                          >
                          <span>
                            <strong>{{ block.settings.title }}</strong>
                            <small>{{ block.settings.price }}</small>
                          </span>
                        </label>
                      {% endfor %}
                    </div>
                    {% if section.settings.addon_options_note != blank %}
                      <p class="ip-form-note">{{ section.settings.addon_options_note }}</p>
                    {% endif %}
                  </div>
                {% endif %}

                <div class="ip-cart-item__actions">
                  <label for="CartQuantity-{{ forloop.index }}">Quantity</label>
                  <input
                    id="CartQuantity-{{ forloop.index }}"
                    type="number"
                    {% if setup_id == blank %}name="updates[{{ item.key }}]"{% endif %}
                    min="0"
                    {% if setup_id != blank %}readonly{% endif %}
                    data-cart-quantity
                    {% if setup_id != blank %}data-cart-setup-quantity{% endif %}
                    data-cart-original-quantity="{{ item.quantity }}"
                    data-cart-line="{{ forloop.index }}"
                    value="{{ item.quantity }}"
                  >
                  {% if setup_id != blank %}
                    <input
                      type="hidden"
                      name="updates[{{ item.key }}]"
                      value="{{ item.quantity }}"
                      data-cart-parent-quantity
                    >
                    <button class="ip-cart-item__remove" type="button" data-cart-setup-remove hidden>{{ 'cart.remove' | t }}</button>
                  {% else %}
                    <a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endunless %}
        {% endfor %}
      </div>

      <div class="ip-card ip-cart__summary">
        <h2>Order summary</h2>
        <dl class="ip-cart__totals">
          <div>
            <dt>Phone subtotal</dt>
            <dd data-cart-subtotal>{{ cart.total_price | money }}</dd>
          </div>
          <div>
            <dt>Shipping</dt>
            <dd data-cart-shipping>{{ flat_shipping | money }}</dd>
          </div>
          <div>
            <dt>Tax</dt>
            <dd>Calculated after address</dd>
          </div>
          <div class="ip-cart__total-emphasis">
            <dt>Due today before tax</dt>
            <dd data-cart-due-today>{{ due_today_before_tax | money }}</dd>
          </div>
          <div class="ip-cart__total-future">
            <dt>Billed on the 1st of the next month</dt>
            <dd data-cart-future-charge>{{ cart_future_charge | money }}</dd>
          </div>
          <div>
            <dt>Estimated savings</dt>
            <dd data-cart-savings>$0</dd>
          </div>
        </dl>
        <p class="ip-note">
          Taxes and recurring billing are shown in checkout. Service and selected add-ons are billed on the 1st of the next month.
        </p>
        <p class="ip-form-note ip-form-note--error" data-cart-integrity-error role="alert" {% unless cart_has_orphan_child or cart_has_incomplete_order %}hidden{% endunless %}>
          Remove every incomplete billing item before checkout, then rebuild that phone order if needed.
        </p>
        <p class="ip-form-note" data-cart-status aria-live="polite" hidden></p>
        <div class="ip-buttons">
          <button type="submit" name="update" formnovalidate>{{ 'cart.update' | t }}</button>
          <button type="submit" name="checkout" {% if cart_has_orphan_child or cart_has_incomplete_order %}disabled aria-disabled="true"{% endif %}>{{ 'cart.checkout' | t }}</button>
        </div>
        <a class="ip-cart__continue" href="{{ routes.root_url }}pages/order-now">Continue shopping</a>
      </div>
    </form>
  {% endif %}
</section>

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "text",
      "id": "addon_options_heading",
      "label": "Add-on options heading",
      "default": "Available add-ons"
    },
    {
      "type": "textarea",
      "id": "addon_options_note",
      "label": "Add-on options note",
      "default": "Add-ons are saved with this phone line so setup can be confirmed after checkout."
    },
    {
      "type": "url",
      "id": "revio_checkout_url",
      "label": "Rev.io checkout handoff URL",
      "info": "Optional. When set, the cart checkout button posts a Rev.io-ready cart payload to this endpoint instead of using native Shopify checkout."
    }
  ],
  "blocks": [
    {
      "type": "addon_option",
      "name": "Add-on option",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Call Recording"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$5/mo"
        },
        {
          "type": "product",
          "id": "billing_product",
          "label": "Billing product"
        }
      ]
    }
  ]
}
{% endschema %}
