[
  {
    "name": "theme_info",
    "theme_name": "Independence Phone",
    "theme_version": "0.1.0",
    "theme_author": "Vilovieta SEO",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "Independence Phone brand",
    "settings": [
      {
        "type": "text",
        "id": "ip_brand_name",
        "label": "Public brand name",
        "default": "Independence Phone"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#172033",
        "label": "t:labels.foreground"
      },
      {
        "type": "header",
        "content": "Independence Phone palette"
      },
      {
        "type": "color",
        "id": "ip_paper_color",
        "default": "#FFFFFF",
        "label": "Page background"
      },
      {
        "type": "color",
        "id": "ip_surface_color",
        "default": "#F4F6F8",
        "label": "Surface"
      },
      {
        "type": "color",
        "id": "ip_ink_color",
        "default": "#172033",
        "label": "Ink"
      },
      {
        "type": "color",
        "id": "ip_muted_color",
        "default": "#596273",
        "label": "Muted text"
      },
      {
        "type": "color",
        "id": "ip_red_color",
        "default": "#B73532",
        "label": "CTA red"
      },
      {
        "type": "color",
        "id": "ip_blue_color",
        "default": "#263F73",
        "label": "Trust blue"
      },
      {
        "type": "color",
        "id": "ip_gold_color",
        "default": "#BA8738",
        "label": "Anniversary gold"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
]
