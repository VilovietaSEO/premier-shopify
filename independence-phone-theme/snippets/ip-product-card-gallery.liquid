{% liquid
  assign media_limit = 6
  assign gallery_title = card_product.title | default: fallback_title
  assign product_media_count = 0
  if card_product != blank and card_product.media.size > 0
    assign product_media_count = card_product.media.size
    if product_media_count > media_limit
      assign product_media_count = media_limit
    endif
  endif

  assign block_image_count = 0
  for block in gallery_blocks
    if block.type == block_type and block.settings.image != blank
      assign block_image_count = block_image_count | plus: 1
    endif
  endfor

  assign gallery_count = product_media_count | plus: block_image_count
  if gallery_count == 0
    assign gallery_count = 1
  endif

  assign slide_index = 0
%}

<div class="ip-product-card__gallery" data-product-gallery data-gallery-title="{{ gallery_title | escape }}">
  <div class="ip-product-card__media" aria-live="polite">
    {% if card_product != blank and card_product.media.size > 0 %}
      {% for media in card_product.media limit: media_limit %}
        {% liquid
          assign media_alt = media.alt | default: gallery_title
          assign active_slide = false
          if slide_index == 0
            assign active_slide = true
          endif
        %}
        <figure
          class="ip-product-card__slide{% if active_slide %} is-active{% endif %}"
          data-gallery-slide="{{ slide_index }}"
          {% if media.media_type == 'image' %}
            data-gallery-open
            role="button"
            tabindex="{% if active_slide %}0{% else %}-1{% endif %}"
            aria-label="Open {{ media_alt | escape }} full view"
          {% endif %}
          {% unless active_slide %}
            hidden
          {% endunless %}
        >
          {% case media.media_type %}
            {% when 'image' %}
              {{
                media
                | image_url: width: 760
                | image_tag:
                  alt: media_alt,
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 34vw, 92vw'
              }}
            {% when 'video' %}
              {{ media | video_tag: controls: true, image_size: '760x', class: 'ip-product-card__video' }}
            {% when 'external_video' %}
              {{ media | external_video_tag: class: 'ip-product-card__external-video' }}
            {% else %}
              {% if media.preview_image %}
                {{
                  media.preview_image
                  | image_url: width: 760
                  | image_tag:
                    alt: media_alt,
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 34vw, 92vw'
                }}
              {% endif %}
          {% endcase %}
        </figure>
        {% assign slide_index = slide_index | plus: 1 %}
      {% endfor %}
    {% endif %}

    {% for block in gallery_blocks %}
      {% if block.type == block_type and block.settings.image != blank %}
        {% liquid
          assign block_alt = block.settings.image.alt | default: gallery_title
          assign active_slide = false
          if slide_index == 0
            assign active_slide = true
          endif
        %}
        <figure
          class="ip-product-card__slide{% if active_slide %} is-active{% endif %}"
          data-gallery-slide="{{ slide_index }}"
          data-gallery-open
          role="button"
          tabindex="{% if active_slide %}0{% else %}-1{% endif %}"
          aria-label="Open {{ block_alt | escape }} full view"
          {% unless active_slide %}
            hidden
          {% endunless %}
          {{ block.shopify_attributes }}
        >
          {{
            block.settings.image
            | image_url: width: 760
            | image_tag:
              alt: block_alt,
              loading: 'lazy',
              sizes: '(min-width: 990px) 34vw, 92vw'
          }}
        </figure>
        {% assign slide_index = slide_index | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if slide_index == 0 %}
      <figure
        class="ip-product-card__slide is-active"
        data-gallery-slide="0"
        data-gallery-open
        role="button"
        tabindex="0"
        aria-label="Open {{ gallery_title | escape }} full view"
      >
        {% if fallback_image != blank %}
          {{
            fallback_image
            | image_url: width: 760
            | image_tag:
              alt: gallery_title,
              loading: 'lazy',
              sizes: '(min-width: 990px) 34vw, 92vw'
          }}
        {% else %}
          <img src="{{ fallback_asset | asset_url }}" alt="{{ gallery_title | escape }}" width="900" height="900" loading="lazy">
        {% endif %}
      </figure>
    {% endif %}
  </div>

  {% if gallery_count > 1 %}
    <div class="ip-product-card__thumbs" aria-label="{{ gallery_title | escape }} images">
      {% assign thumb_index = 0 %}
      {% if card_product != blank and card_product.media.size > 0 %}
        {% for media in card_product.media limit: media_limit %}
          <button
            class="ip-product-card__thumb{% if thumb_index == 0 %} is-active{% endif %}"
            type="button"
            data-gallery-thumb="{{ thumb_index }}"
            aria-label="Show {{ gallery_title | escape }} image {{ thumb_index | plus: 1 }}"
            aria-pressed="{% if thumb_index == 0 %}true{% else %}false{% endif %}"
          >
            {% if media.preview_image %}
              {{
                media.preview_image
                | image_url: width: 180
                | image_tag:
                  alt: '',
                  loading: 'lazy'
              }}
            {% else %}
              <span>{{ media.media_type | replace: '_', ' ' }}</span>
            {% endif %}
          </button>
          {% assign thumb_index = thumb_index | plus: 1 %}
        {% endfor %}
      {% endif %}

      {% for block in gallery_blocks %}
        {% if block.type == block_type and block.settings.image != blank %}
          <button
            class="ip-product-card__thumb{% if thumb_index == 0 %} is-active{% endif %}"
            type="button"
            data-gallery-thumb="{{ thumb_index }}"
            aria-label="Show {{ gallery_title | escape }} image {{ thumb_index | plus: 1 }}"
            aria-pressed="{% if thumb_index == 0 %}true{% else %}false{% endif %}"
          >
            {{
              block.settings.image
              | image_url: width: 180
              | image_tag:
                alt: '',
                loading: 'lazy'
            }}
          </button>
          {% assign thumb_index = thumb_index | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</div>
