{% comment %}
  Shared Order Now builder used by the dedicated section and the default page-router fallback.
{% endcomment %}
{% liquid
  assign standard_variant = standard_product.selected_or_first_available_variant
  assign rugged_variant = rugged_product.selected_or_first_available_variant
  assign monthly_service_variant = monthly_service_product.selected_or_first_available_variant
  assign annual_service_variant = annual_service_product.selected_or_first_available_variant
  assign call_recording_variant = call_recording_product.selected_or_first_available_variant
  assign quiet_hours_variant = family_quiet_hours_product.selected_or_first_available_variant
  assign voicemail_variant = voicemail_to_email_product.selected_or_first_available_variant
  assign auto_attendant_variant = auto_attendant_product.selected_or_first_available_variant
  assign addon_bundle_variant = addon_bundle_product.selected_or_first_available_variant
  assign default_variant_id = standard_variant.id

  if default_variant_id == blank
    assign default_variant_id = rugged_variant.id
  endif
%}

<section class="ip-section ip-order-builder" data-order-builder>
  <div class="ip-order-builder__header ip-stack">
    <h1 class="ip-heading ip-heading--medium ip-heading--wide">{{ heading }}</h1>
    <div class="ip-lede">{{ body }}</div>
  </div>

  <form
    action="{{ routes.cart_add_url }}"
    method="post"
    enctype="multipart/form-data"
    class="ip-product-form ip-order-builder__form"
    data-order-form
  >
    <input type="hidden" name="id" value="{{ default_variant_id }}" data-order-variant-id>
    <input type="hidden" name="quantity" value="1">

    <fieldset class="ip-choice-group ip-order-builder__step ip-order-builder__step--phone">
      <legend class="ip-order-builder__section-title">
        <span class="ip-order-builder__step-number">1</span>
        <span>Choose your phone</span>
      </legend>
      <div class="ip-order-builder__grid ip-order-builder__grid--phones">
        <label class="ip-choice ip-order-card ip-order-card--phone" for="OrderPhoneStandard-{{ builder_id }}">
          <input
            id="OrderPhoneStandard-{{ builder_id }}"
            type="radio"
            name="properties[Phone]"
            value="Classic Phone - $100"
            data-order-phone
            data-order-variant="{{ standard_variant.id }}"
            data-order-title="Classic Phone"
            data-order-price-cents="10000"
            data-order-image="{{ 'ip-classic-phone-front.webp' | asset_url }}"
            checked
          >
          <span>
            <strong>Classic Phone</strong>
            <small>$100 one-time</small>
            <em>
              Wi-Fi, Bluetooth, encrypted data transmission and storage, 9-hour talk time.
              <a href="/pages/faq#phone-comparison" data-phone-description-link>Click here for a description of the phone.</a>
            </em>
          </span>
          <div class="ip-order-card__phone-media ip-order-card__phone-media--classic">
            <video
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
              poster="{{ 'ip-classic-phone-front.webp' | asset_url }}"
              aria-label="Rotating view of the Classic Phone"
            >
              <source src="{{ 'ip-classic-phone-spin.mp4' | asset_url }}" type="video/mp4">
            </video>
            <noscript>
              <img src="{{ 'ip-classic-phone-front.webp' | asset_url }}" alt="Full front view of the Classic Phone" width="800" height="640" loading="lazy">
            </noscript>
          </div>
        </label>

        <label class="ip-choice ip-order-card ip-order-card--phone" for="OrderPhoneRugged-{{ builder_id }}">
          <input
            id="OrderPhoneRugged-{{ builder_id }}"
            type="radio"
            name="properties[Phone]"
            value="Rugged Phone - $150"
            data-order-phone
            data-order-variant="{{ rugged_variant.id }}"
            data-order-title="Rugged Phone"
            data-order-price-cents="15000"
            data-order-image="{{ 'ip-rugged-phone-front.webp' | asset_url }}"
          >
          <span>
            <strong>Rugged Phone</strong>
            <small>$150 one-time</small>
            <em>
              Wi-Fi, Bluetooth, encrypted data transmission and storage, 9-hour talk time, waterproof, drop proof.
              <a href="/pages/faq#phone-comparison" data-phone-description-link>Click here for a description of the phone.</a>
            </em>
          </span>
          <div class="ip-order-card__phone-media ip-order-card__phone-media--rugged">
            <video
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
              poster="{{ 'ip-rugged-phone-front.webp' | asset_url }}"
              aria-label="Rotating view of the Rugged Phone"
            >
              <source src="{{ 'ip-rugged-phone-spin.mp4' | asset_url }}" type="video/mp4">
            </video>
            <noscript>
              <img src="{{ 'ip-rugged-phone-front.webp' | asset_url }}" alt="Full front view of the Rugged Phone" width="800" height="640" loading="lazy">
            </noscript>
          </div>
        </label>
      </div>
    </fieldset>

    <fieldset class="ip-choice-group ip-order-builder__step ip-order-builder__step--service">
      <legend class="ip-order-builder__section-title">
        <span class="ip-order-builder__step-number">2</span>
        <span>Choose your service plan — Billed on the 1st of the next month</span>
      </legend>
      <div class="ip-order-builder__grid ip-order-builder__grid--two">
        <label class="ip-choice ip-order-card" for="OrderPlanMonthly-{{ builder_id }}">
          <input
            id="OrderPlanMonthly-{{ builder_id }}"
            type="radio"
            name="properties[Service plan]"
            value="Monthly service - $17.76/mo"
            data-billing-variant="{{ monthly_service_variant.id }}"
            data-billing-role="service"
            data-future-charge-cents="1776"
            data-billing-cadence="monthly"
            data-first-bill-rule="first_day_of_next_month"
            checked
          >
          <span>
            <strong>Monthly service</strong>
            <small>$17.76/mo</small>
            <em>Personal phone number and monthly service.</em>
          </span>
        </label>

        <label class="ip-choice ip-order-card" for="OrderPlanAnnual-{{ builder_id }}">
          <input
            id="OrderPlanAnnual-{{ builder_id }}"
            type="radio"
            name="properties[Service plan]"
            value="Annual service - $200/yr (saves $13.12/yr)"
            data-order-annual
            data-order-savings-year="1312"
            data-billing-variant="{{ annual_service_variant.id }}"
            data-billing-role="service"
            data-future-charge-cents="20000"
            data-billing-cadence="annual"
            data-first-bill-rule="first_day_of_next_month"
          >
          <span>
            <strong>Annual service</strong>
            <small>$200/yr</small>
            <em>Saves $13.12 compared with 12 monthly payments.</em>
          </span>
        </label>
      </div>
    </fieldset>

    <fieldset class="ip-choice-group ip-order-builder__step ip-order-builder__step--addons">
      <legend class="ip-order-builder__section-title">
        <span class="ip-order-builder__step-number">3</span>
        <span>Choose add-ons — Billed on the 1st of the next month</span>
      </legend>
      <div class="ip-order-builder__grid ip-order-builder__grid--addons">
        <label class="ip-choice ip-order-card ip-order-card--bundle" for="OrderAddonBundle-{{ builder_id }}">
          <input
            id="OrderAddonBundle-{{ builder_id }}"
            type="checkbox"
            name="properties[Add-on Bundle]"
            value="Add-on Bundle - $10/mo; includes Call Recording, Quiet Hours, Voicemail to Email, and Auto Attendant (saves $10/mo)"
            data-order-bundle
            data-order-savings-month="1000"
            data-billing-variant="{{ addon_bundle_variant.id }}"
            data-billing-role="addon_bundle"
            data-future-charge-cents="1000"
            data-billing-cadence="monthly"
            data-first-bill-rule="first_day_of_next_month"
          >
          <span>
            <strong>Add-on Bundle</strong>
            <small>$10/mo</small>
            <em>Includes every add-on: Call Recording, Quiet Hours, Voicemail to Email, and Auto Attendant. Saves $10/mo.</em>
          </span>
        </label>

        <label class="ip-choice ip-order-card" for="OrderAddonRecording-{{ builder_id }}">
          <input id="OrderAddonRecording-{{ builder_id }}" type="checkbox" name="properties[Call Recording]" value="$5/mo" data-order-addon data-billing-variant="{{ call_recording_variant.id }}" data-billing-role="addon" data-future-charge-cents="500" data-billing-cadence="monthly" data-first-bill-rule="first_day_of_next_month">
          <span>
            <strong>Call Recording</strong>
            <small>$5/mo</small>
            <em>Access to 90 days of recorded calls.</em>
          </span>
        </label>

        <label class="ip-choice ip-order-card" for="OrderAddonQuietHours-{{ builder_id }}">
          <input id="OrderAddonQuietHours-{{ builder_id }}" type="checkbox" name="properties[Quiet Hours]" value="$5/mo" data-order-addon data-billing-variant="{{ quiet_hours_variant.id }}" data-billing-role="addon" data-future-charge-cents="500" data-billing-cadence="monthly" data-first-bill-rule="first_day_of_next_month">
          <span>
            <strong>Quiet Hours</strong>
            <small>$5/mo</small>
            <em>Set times for when to receive incoming calls.</em>
          </span>
        </label>

        <label class="ip-choice ip-order-card" for="OrderAddonVoicemail-{{ builder_id }}">
          <input id="OrderAddonVoicemail-{{ builder_id }}" type="checkbox" name="properties[Voicemail to Email]" value="$5/mo" data-order-addon data-billing-variant="{{ voicemail_variant.id }}" data-billing-role="addon" data-future-charge-cents="500" data-billing-cadence="monthly" data-first-bill-rule="first_day_of_next_month">
          <span>
            <strong>Voicemail to Email</strong>
            <small>$5/mo</small>
            <em>Voicemail messages are sent to email as audio and transcription.</em>
          </span>
        </label>

        <label class="ip-choice ip-order-card" for="OrderAddonAttendant-{{ builder_id }}">
          <input id="OrderAddonAttendant-{{ builder_id }}" type="checkbox" name="properties[Auto Attendant]" value="$5/mo" data-order-addon data-billing-variant="{{ auto_attendant_variant.id }}" data-billing-role="addon" data-future-charge-cents="500" data-billing-cadence="monthly" data-first-bill-rule="first_day_of_next_month">
          <span>
            <strong>Auto Attendant</strong>
            <small>$5/mo</small>
            <em>Filter unwanted spam calls.</em>
          </span>
        </label>
      </div>
    </fieldset>

    <div class="ip-order-builder__referral">
      <label for="OrderReferral-{{ builder_id }}">Discount/referral code</label>
      <input
        id="OrderReferral-{{ builder_id }}"
        type="text"
        name="properties[Discount/referral code]"
        maxlength="80"
        autocomplete="off"
        placeholder="Optional"
      >
    </div>

    <aside class="ip-card ip-order-summary" aria-live="polite">
      <p class="ip-kicker">Order summary</p>
      <h2 data-order-summary-title>Classic Phone</h2>
      <dl>
        <div>
          <dt>Phone</dt>
          <dd data-order-summary-phone>$100 one-time</dd>
        </div>
        <div>
          <dt>Service</dt>
          <dd data-order-summary-service>$17.76/mo</dd>
        </div>
        <div>
          <dt>Add-ons</dt>
          <dd data-order-summary-addons>None selected</dd>
        </div>
        <div>
          <dt>Estimated savings</dt>
          <dd data-order-summary-savings>$0</dd>
        </div>
      </dl>
      <p class="ip-form-note">{{ checkout_note }}</p>
      <button
        type="submit"
        data-add-to-cart-button
        data-order-script-required
        data-order-configured="{% if default_variant_id != blank %}true{% else %}false{% endif %}"
        data-default-text="{{ button_label }}"
        disabled
      >
        {{ button_label }}
      </button>
      <p class="ip-form-note" data-cart-status aria-live="polite" hidden></p>
    </aside>
  </form>
</section>
